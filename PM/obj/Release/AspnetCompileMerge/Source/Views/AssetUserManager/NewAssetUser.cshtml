@model PM.ModelsV.StartNew

@{
    ViewBag.Title = "Asset User";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-2">
        <input type="text" id="assetstaff" name="assetstaff" class="form-control" placeholder="staff id or asset code name" />
    </div>
    <div class="col-md-2">
        <input type="button" id="vasset" class="btn btn-primary" value="Asset" />
        <input type="button" id="vstaff" class="btn btn-primary" value="User" />
    </div>
    <div class="col-md-8">
        <input type="text" style="font-weight: bold; color:red"  id="assetstaffdata" name="assetstaffdata"  class="hidden form-control" placeholder="you can check here asset or user detail information" readonly />
    </div>
</div>
<br />
<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        <p style="text-align:center; color:red;">Please make adjustment accesories item before proceeding(if required).</p>
        @using (Html.BeginForm("NewAssetUser", "AssetUserManager", FormMethod.Post, new { id = "frmMain" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-3">
                    <h4>Asset Selection</h4>
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Business</span>
                        @Html.DropDownList("F_ASET_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FromDept();" })
                        @Html.ValidationMessage("F_ASET_BUSINESS", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <h4>User Selection</h4>
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Business</span>
                        @Html.DropDownList("U_ASET_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FromUDept();" })
                        @Html.ValidationMessage("U_ASET_BUSINESS", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <h4>Working Selection</h4>
                    <div class="form-group input-group">
                        <span class="input-group-addon">To Business</span>
                        @Html.DropDownList("T_ASET_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "ToDept();" })
                        @Html.ValidationMessage("T_ASET_BUSINESS", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <h4>Tranasfer Information</h4>
                    <div class="form-group input-group">
                        <span class="input-group-addon">Date</span>
                        @Html.Editor("AU_SRDATE", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "dd/MM/yyyy", type = "date" } })
                        @Html.ValidationMessage("AU_SRDATE", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Department</span>
                        @Html.DropDownList("F_ASET_DEPARTMENT", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "ClearAsset();" })
                        @Html.ValidationMessage("F_ASET_DEPARTMENT", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Department</span>
                        @Html.DropDownList("U_ASET_DEPARTMENT", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("U_ASET_DEPARTMENT", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">To Department</span>
                        @Html.DropDownList("T_ASET_DEPARTMENT", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("T_ASET_DEPARTMENT", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Mileage</span>
                        @Html.Editor("AU_SMILEAGE", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Mileage", type = "number" } })
                        @Html.ValidationMessage("AU_SMILEAGE", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Group</span>
                        @Html.DropDownList("F_ASET_GROUP", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FromAsset();" })
                        @Html.ValidationMessage("F_ASET_GROUP", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">From Area</span>
                        @Html.DropDownList("U_ASET_AREA", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FromUser();" })
                        @Html.ValidationMessage("U_ASET_AREA", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">To Area</span>
                        @Html.DropDownList("T_ASET_AREA", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("T_ASET_AREA", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Transfer Type</span>
                        @Html.DropDownList("AU_TRNSTYPE", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("AU_TRNSTYPE", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Vehicle</span>
                        @Html.DropDownList("F_ASET_ID", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FindAcceByAset();" })
                        @Html.ValidationMessage("F_ASET_ID", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">User</span>
                        @Html.DropDownList("U_ASET_USER", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FindUserAsset();" })
                        @Html.ValidationMessage("U_ASET_USER", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Reason</span>
                        @Html.Editor("ASET_NOTE", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Reason of Transfer", maxlength = "50" } })
                        @Html.ValidationMessage("ASET_NOTE", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
                    <div class="row">
                        <div class="form-group col-md-12">
                            <input type="text" id="UserInfoDATA" class="form-control" placeholder="User current assets" readonly />
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-12">
                            <button type="button" name="btn" id="submitBtn" data-toggle="modal" data-target="#confirm-submit" class="btn btn-danger pull-right"><span class="fa fa-save"></span> Save</button>
                            <a href="@Url.Action("Index","AssetUserManager")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        </div>
                    </div>
        }
        <div id="LoadPartialView"></div>
    </div>
    <div class="panel-footer">
        New Asset User
    </div>
</div>


<div class="modal fade" id="confirm-submit" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                Confirm Submit
            </div>
            <div class="modal-body">
                Are you sure you want to submit?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <a href="#" id="submit" class="btn btn-success success">Submit</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/AssetUserManager/NewAssetUser.js"></script>
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}

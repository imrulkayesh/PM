@model PM.ModelsV.ChangePassVM
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("ChangePassword", "Home"))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal col-md-6">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.Label("User Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-8">
                @Html.Label("NameOfUser", Convert.ToString((string)ViewBag.StaffName), htmlAttributes: new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-8">
                @Html.PasswordFor(model => model.Password, htmlAttributes: new { @class = "form-control", placeholder = "Enter Password", onchange = "CheckValid();" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Passwords, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-8">
                @Html.PasswordFor(model => model.Passwords, htmlAttributes: new { @class = "form-control", placeholder = "Re-enter Password", onchange = "CheckValid();" })
                @Html.ValidationMessageFor(model => model.Passwords, "", new { @class = "text-danger" })
                <p id="pwd" class="alert-error" color="red"></p>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-8">
                <input type="submit" value="Change Password" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

@section scripts{
    <script>
        function CheckValid() {
            var P1 = document.getElementById('Password').value;
            var P2 = document.getElementById('Passwords').value;
            if (P1 != P2) {
                $("input[type='submit']").attr('disabled', 'disabled');
                $('#pwd').text('Confirm password not matched ');
            } else {
                if (P1.length <= 5) {
                    $("input[type='submit']").attr('disabled', 'disabled');
                    $('#pwd').text('Password minimum length 6 characters');
                } else {
                    $("input[type='submit']").removeAttr('disabled');
                    $('#pwd').text('');
                }
            }
        }
    </script>
}

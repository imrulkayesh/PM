@model IEnumerable<PM.ModelsV.BundleInspectionApp>

@{
    ViewBag.Title = "Bundle Payment";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
    <table class="table">
        <tr>
            <th>
                #
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BUNDLE_ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TOTAL_ASET)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AMOUNT)
            </th>
            <th>Receiver Name</th>
            <th>Bill Note</th>
            <th>#</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <input type="submit" class="btn4 btn btn-flat btn-primary" value="View" data-url="@Url.Action("BundleJobCardAppView", "Inspection", new { id = item.BUNDLE_ID })" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BUNDLE_ID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TOTAL_ASET)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AMOUNT)
                </td>

                @using (Html.BeginForm("BundlePayment", "BillPayment", new { id = item.BUNDLE_ID }, FormMethod.Post))
                {
                    <td>
                        @Html.Hidden("BUNDLE_ID", value: item.BUNDLE_ID)
                        @Html.Editor("RECEIVER_NAME", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Receiver Name" } })
                    </td>
                    <td>
                        @Html.Editor("BILL_NOTE", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Bill Note" } })
                    </td>
                    <td>
                        <input type="submit" value="Create Bill" class="btn btn-flat btn-danger" />
                    </td>
                }
         
            </tr>
        }
    </table>
<hr/>
<div id="VDI" class="table-responsive"></div>
@section scripts{
    <script>
        $(document).ready(function () {
            $('.btn4').click(function () {
                var url = $(this).data('url');
                $.get(url, function (data) {
                    $('#VDI').html(data);
                });
            });
        });
    </script>
    
    }
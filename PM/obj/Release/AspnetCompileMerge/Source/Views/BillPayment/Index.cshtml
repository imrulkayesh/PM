@model IEnumerable<PM.ModelsV.BillPayment>

@{
    ViewBag.Title = "Bill Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "BillPayment", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("BillNumber", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Bill Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
                <!-- /btn-group -->
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewPayment", "BillPayment")" class="btn btn-success"> New Bill</a>
            <a href="@Url.Action("BundlePayment", "BillPayment")" class="btn btn-primary"> Bundle Bill</a>
            <a href="@Url.Action("Index","BillPayment")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_REF)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_RECEIVER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_PAID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_IPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_UPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BILH_CPAY)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a href="@Url.Action("BillPrintNow", "BillPayment", new { id=item.BILH_ID})" class="btn btn-primary" target="_blank"> Print</a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_NOTE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_REF)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_RECEIVER)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_PAID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_IPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_UPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.BILH_CPAY)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

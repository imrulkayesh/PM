@model PM.ModelsV.CaseAndPenalty

@{
    ViewBag.Title = "New Case";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Occurance Date</span>
                        @Html.EditorFor(model => model.PLEA_DATE, new { htmlAttributes = new { @class = "form-control", type = "date", placeholder = "dd/MM/yyyy" } })
                        @Html.ValidationMessageFor(model => model.PLEA_DATE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Asset</span>
                        @Html.DropDownListFor(model => model.PLEA_ASET, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", autofocus = true, onchange = "getDetail();" })
                        @Html.ValidationMessageFor(model => model.PLEA_ASET, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Mileage</span>
                        @Html.EditorFor(model => model.PLEA_MILEAGE, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "Mileage" } })
                        @Html.ValidationMessageFor(model => model.PLEA_MILEAGE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Plea On</span>
                        @Html.DropDownListFor(model => model.PLEA_DFND, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessageFor(model => model.PLEA_DFND, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Referance No</span>
                        @Html.EditorFor(model => model.PLEA_REF, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Violence Number" } })
                        @Html.ValidationMessageFor(model => model.PLEA_REF, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Reason</span>
                        @Html.DropDownListFor(model => model.PLEA_REASON_ID, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessageFor(model => model.PLEA_REASON_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Location</span>
                        @Html.EditorFor(model => model.PLEA_LOCATION, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Occurance Area Name" } })
                        @Html.ValidationMessageFor(model => model.PLEA_LOCATION, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Amout</span>
                        @Html.EditorFor(model => model.PLEA_AMNT, new { htmlAttributes = new { @class = "form-control", type = "Number", placeholder = "Penalty Amount" } })
                        @Html.ValidationMessageFor(model => model.PLEA_AMNT, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Paid By</span>
                        @Html.DropDownListFor(model => model.PLEA_PAID_BY, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessageFor(model => model.PLEA_PAID_BY, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Note</span>
                        @Html.EditorFor(model => model.PLEA_DESC, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Note" } })
                        @Html.ValidationMessageFor(model => model.PLEA_DESC, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <input type="text" id="pleadetail" disabled="disabled" class="form-control" placeholder="Asset Details" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="btn-group col-md-12">
                    <a href="@Url.Action("Index","CaseAndPenalty")" c class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                    <a href="@Url.Action("NewCase","CaseAndPenalty")" cl class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Submit</button>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        New Case Entry
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function getDetail() {
            var url = 'getDetail';
            var PLEA_ASET = $('#PLEA_ASET').val();
            var PLEA_DATE = $('#PLEA_DATE').val();
            if (PLEA_ASET == "" || PLEA_DATE == "") {
                Dis();
                return;
            }
            $.getJSON(url, { id: PLEA_ASET, pdt: PLEA_DATE }, function (response) {
                $('#pleadetail').val(response.MSG);
                if (response.success) {
                    Ena();
                } else {
                    Dis();
                }
            });
        }
        function Dis() {
            $("#PLEA_MILEAGE").prop("disabled", true);
            $("#PLEA_AMNT").prop("disabled", true);
            $("#PLEA_PAID_BY").prop("disabled", true);
            $("#PLEA_REF").prop("disabled", true);
            $("#PLEA_DFND").prop("disabled", true);
            $("#PLEA_REASON_ID").prop("disabled", true);
            $(':input[type="submit"]').prop('disabled', true);
            $('#pleadetail').val('');
        }
        function Ena() {
            $("#PLEA_MILEAGE").prop("disabled", false);
            $("#PLEA_AMNT").prop("disabled", false);
            $("#PLEA_PAID_BY").prop("disabled", false);
            $("#PLEA_REF").prop("disabled", false);
            $("#PLEA_DFND").prop("disabled", false);
            $("#PLEA_REASON_ID").prop("disabled", false);
            $(':input[type="submit"]').prop('disabled', false);
        }
    </script>
}

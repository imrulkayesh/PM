@model PM.ModelsV.EditJobCard

@{
    ViewBag.Title = "Edit Job Card";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.JOBH_ID);
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Asset</span>
                        @Html.DropDownListFor(model => model.JOBH_ASET, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", disabled="disabled" })
                        @Html.ValidationMessageFor(model => model.JOBH_ASET, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Inspection</span>
                        @Html.EditorFor(model => model.INSPH_ID, new { htmlAttributes = new { @class = "form-control", type = "text", disabled="disabled"} })
                        @Html.ValidationMessageFor(model => model.INSPH_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Job Vendor</span>
                        @Html.EditorFor(model => model.JOBH_VENDOR, new { htmlAttributes = new { @class = "form-control", required="required", placeholder= "Whorkshop (Max 50 Char)" } })
                        @Html.ValidationMessageFor(model => model.JOBH_VENDOR, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Recommendation</span>
                        @Html.EditorFor(model => model.JOBH_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder= "Note/Recommendation (Max 50 Char)", required = "required" } })
                        @Html.ValidationMessageFor(model => model.JOBH_NOTE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">User Pay</span>
                        @Html.EditorFor(model => model.JOBH_UPAY, new { htmlAttributes = new { @class = "form-control" ,placeholder="Deduction Amount"} })
                        @Html.ValidationMessageFor(model => model.JOBH_UPAY, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Insurance Pay</span>
                        @Html.EditorFor(model => model.JOBH_IPAY, new { htmlAttributes = new { @class = "form-control", placeholder = "Deduction Amount" } })
                        @Html.ValidationMessageFor(model => model.JOBH_IPAY, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="box box-primary">
                <div id="DetailItem" class="table-responsive"></div>
                <table id="JobDetailBody" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>iQty</th>
                            <th>iRate</th>
                            <th>jQty</th>
                            <th>jRate</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.JobCardDetails)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.JOBD_ITEM)</td>
                                <td>@Html.DisplayFor(modelItem => item.JOBD_ITEM_NAME)</td>
                                <td>@Html.DisplayFor(modelItem => item.JOBD_IQTY)</td>
                                <td>@Html.DisplayFor(modelItem => item.JOBD_IRATE)</td>
                                <td>@Html.EditorFor(model => item.JOBD_JQTY, new { htmlAttributes = new { @class = "form-control", placeholder = "J Qty" } })</td>
                                <td>@Html.EditorFor(model => item.JOBD_JRATE, new { htmlAttributes = new { @class = "form-control", placeholder = "J Rate" } })</td>
                                <td>@Html.EditorFor(model => item.JOBD_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note" } })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="btn-group col-md-12">
                    <a href="@Url.Action("JobCard","Inspection")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                    <button type="submit" id="EditJob" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Update Job Card</button>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        New Job Entry
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Inspection/EditJobCard.js"></script>
}

@model IEnumerable<PM.ModelsV.BundleInspectionApp>

@{
    ViewBag.Title = "Bundle Inspection Approval";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
    <table class="table">
        <tr>
            <th>
                #
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BUNDLE_ID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TOTAL_ASET)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AMOUNT)
            </th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @using (Html.BeginForm("BundleInspectionApp", "Inspection", new { id=item.BUNDLE_ID},FormMethod.Post))
                    {
                    <input type="submit" value="Approve" class="btn btn-flat btn-danger"/>
                    }
                    @using (Html.BeginForm("BundleInspectionDel", "Inspection", new { id = item.BUNDLE_ID }, FormMethod.Post))
                    {
                        <input type="submit" value="Del" class="btn btn-flat btn-warning" />
                    }
                    <input type="submit" class="btn4 btn btn-flat btn-primary" value="View" data-url="@Url.Action("BundleInspectionAppView", "Inspection", new { id = item.BUNDLE_ID })" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BUNDLE_ID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TOTAL_ASET)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AMOUNT)
                </td>
         
            </tr>
        }
    </table>
<hr/>
<div id="VDI" class="table-responsive"></div>
@section scripts{
    <script>
        $(document).ready(function () {
            $('.btn4').click(function () {
                var url = $(this).data('url');
                $.get(url, function (data) {
                    $('#VDI').html(data);
                });
            });
        });
    </script>
    
    }
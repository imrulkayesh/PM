@model IEnumerable<PM.Controllers.cls_ViewPolicyDetailByVehicleBD>


<table class="table">
    <thead>
        <tr>
            <th>
                Aset
            </th>
            <th>
                Capacity
            </th>
            <th>
                Year
            </th>
            <th>
                Policy
            </th>
            <th>
                Premium
            </th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.aset_code_name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.aset_capacity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.aset_mfg_year)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.insu_policy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.insu_premium)
                </td>
            </tr>
        }
    </tbody>

</table>

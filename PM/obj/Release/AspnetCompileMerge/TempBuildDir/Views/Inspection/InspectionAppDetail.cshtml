@model IEnumerable<PM.ModelsV.InspectionD_With_Old>
@{
    ViewBag.Title = "Inspection App Detail";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div id="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.INSPD_LINE)</th>
                <th>@Html.DisplayNameFor(model => model.INSPD_ITEM)</th>
                <th>@Html.DisplayNameFor(model => model.INSPD_ITEM_NAME)</th>
                <th>@Html.DisplayNameFor(model => model.INSPD_IQTY)</th>
                <th>@Html.DisplayNameFor(model => model.INSPD_IRATE)</th>
                <th>Amount</th>
                <th>@Html.DisplayNameFor(model => model.INSPD_NOTE)</th>
                <th>@Html.DisplayNameFor(model => model.INSPH_DATE)</th>
                <th>@Html.DisplayNameFor(model => model.MILEAGE)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_LINE)</td>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_ITEM)</td>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_ITEM_NAME)</td>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_IQTY)</td>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_IRATE)</td>
                    <td>
                        @{
                        decimal Amount = item.INSPD_IQTY * item.INSPD_IRATE ?? 0;
                        }
                        @Amount
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.INSPD_NOTE)</td>
                    <td>@Html.DisplayFor(modelItem => item.INSPH_DATE)</td>
                    <td>@Html.DisplayFor(modelItem => item.MILEAGE)</td>
                </tr>
                            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">@ViewBag.ASET_ID</th>
                <th colspan="2">@ViewBag.INSPH</th>
                <th style="text-decoration:underline">Amount: </th>
                <th style="text-decoration:underline">@ViewBag.IAmount </th>
                <th>@using (Html.BeginForm("AppIns", "Inspection"))
                {
                    @Html.Hidden("id")
                    <input type="submit" class="btn btn-danger btn-flat" value="Approve" />
                }</th>
                <th>
                    @using (Html.BeginForm("RejIns", "Inspection"))
                    {
                        @Html.Hidden("id")
                        <input type="submit" class="btn btn-info btn-flat" value="Reject" />
                    }
                </th>
                <th><a href="@Url.Action("InsApproval","Inspection")" class="btn btn-primary">Back</a></th>
            </tr>
        </tfoot>
    </table>
</div>

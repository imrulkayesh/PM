@model PM.ModelsV.Report_Police_Case
@{
    ViewBag.Title = "Report_Police_Case";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="col-md-12">
    <div class="box box-warning box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">Police Case</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            @using (Html.BeginForm("Report_Police_Case", "ReportManager"))
            {
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">From Date</span>
                            @Html.EditorFor(model => model.F_BILH_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", type = "date", placeholder = "From Date" } })
                            @Html.ValidationMessageFor(model => model.F_BILH_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">To Date</span>
                            @Html.EditorFor(model => model.T_BILH_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", type = "date", placeholder = "To Date" } })
                            @Html.ValidationMessageFor(model => model.T_BILH_DATE, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Asset</span>
                            @Html.DropDownList("ASET_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("ASET_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Area</span>
                            @Html.DropDownList("AREA_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("AREA_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Business</span>
                            @Html.DropDownList("BUSINESS_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("BUSINESS_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Type</span>
                            @Html.DropDownList("TYPE_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("TYPE_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <button type="submit" class="btn bg-olive btn-flat margin">Submit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>
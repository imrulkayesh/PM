@model IEnumerable<PM.ModelsV.InsuranceDetail>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.INSU_LINE)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.INSU_PREMIUM)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.INSU_AMOUNT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.INSU_VAT_AMOUNT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.INSU_DATE)
            </th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.INSU_LINE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSU_PREMIUM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSU_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSU_VAT_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSU_DATE)
                </td>
            </tr>
        }
        <tr>
            <td>@ViewBag.INSUH</td>
            <td>@ViewBag.PAmount</td>
            <td>@ViewBag.IAmount</td>
            <td>@ViewBag.VAmount</td>
            <td></td>
        </tr>
    </tbody>

</table>

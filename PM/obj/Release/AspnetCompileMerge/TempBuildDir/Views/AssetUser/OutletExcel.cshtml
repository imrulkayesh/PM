@model PM.ModelsV.ExcelInputVM
@{
    ViewBag.Title = "New Outlet Excel";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div id="overlay" class="hide">
    <div class="loader">
    </div>
</div>


@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.MyExcelFile, new { type = "file", required = "required" })
                            <p class="help-block">.xlsx file format only and maximum 50 rows in Excel file</p>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">Load Excel File</button>
                            <a href="@Url.Action("Outlet","AssetUser")" class="btn btn-primary">Back</a>
                        </div>
                        <div class="col-md-4">
                            <span style="color:red">
                                <strong>
                                    @Html.ValidationMessageFor(x => x.MyExcelFile)
                                </strong>
                            </span>
                        </div>
                    </div>
                </div>
                <form id="NewUploadForm">
                    <div class="panel-body">
                        <div class="table-responsive">
                            @Html.Raw(Model.MSExcelTable)
                        </div>
                        <div class="table-responsive">

                        </div>
                    </div>
                    <div class="panel-footer">
                        <button id="saveDatabase" type="submit" class="btn btn-primary">Check &amp; Upload</button>
                    </div>
                </form>
            </div>
            <div class="panel box box-danger">
                <div class="box-header with-border">
                    <h4 class="box-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" style="color:blue">
                            Excel Format
                        </a>
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse">
                    <div class="box-body">
                        <h4 style="color:red">NewOutletExcel.xlsx</h4>
                        <table class="table" border="1">
                            <thead>
                                <tr>
                                    <th>OUTLET_CODE</th>
                                    <th>OUTLET_NAME</th>
                                    <th>PROPRIETOR</th>
                                    <th>MOBILE</th>
                                    <th>ADDRESS</th>
                                    <th>NOTE</th>
                                    <th>AREA</th>
                                    <th>DEPARTMENT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>OC-00001</td>
                                    <td>Maa Enterprise</td>
                                    <td>Md. Saidul Islam</td>
                                    <td>12345678</td>
                                    <td>Uttara, Dhaka</td>
                                    <td>Fridge given</td>
                                    <td>RSB49141</td>
                                    <td>DT0052</td>
                                </tr>
                                <tr>
                                    <td>OC-00002</td>
                                    <td>M/S Traders</td>
                                    <td>Md. Jahidul Alam</td>
                                    <td>12345678</td>
                                    <td>Pallabi, Dhaka</td>
                                    <td>New Outlet</td>
                                    <td>RSB49141</td>
                                    <td>DT0052</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.col-lg-4 -->
    </div>
}
@section scripts{
    <script src="~/Scripts/AssetUser/OutletExcel.js"></script>
}
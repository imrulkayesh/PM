@model IEnumerable<PM.ModelsV.InsuranceMasterVM>
@{
    ViewBag.Title = "Insurance List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("InsuranceMaster", "InsuranceManager", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("Insurance", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "NewInsurance Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewInsuranceMaster", "InsuranceManager")" class="btn btn-primary"> New Insurance</a>
            <a href="@Url.Action("InsuranceMaster","InsuranceManager")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>

                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_TYPE_ID)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_COMPANY_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_NUMBER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANE_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_EXPAIR_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NET_PREMIUM)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VAT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.STAMP)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TOTAL_PREMIUM)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.KICK_BACK_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.KICK_BACK_PERCENTAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ACTUAL_PAID_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.KICK_BACK_STATUS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DESCRIPTION)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.KICKBACK_FROM)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REQUEST_BY)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
                {
            <tr>
                <td>
                    <div class="input-group-btn">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                            Action
                            <span class="fa fa-caret-down"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <input type="submit" class="FileUp form-control btn btn-flat btn-primary" value="Discount" data-url="@Url.Action("KickBack","InsuranceManager", new { id= item.INSURANCE_MST_ID})" />
                            </li>
                        </ul>
                    </div>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.COMPANY_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_TYPE_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INS_COMPANY_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_NUMBER)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANE_DATE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_EXPAIR_DATE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NET_PREMIUM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VAT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.STAMP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TOTAL_PREMIUM)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.KICK_BACK_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.KICK_BACK_PERCENTAGE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ACTUAL_PAID_AMOUNT)
                </td>
                <td>
                    @if (item.KICK_BACK_STATUS == "2")
                    {
                        <span class="label label-success">Received</span>
                    }
                    else if (item.KICK_BACK_STATUS == "1")
                    {
                        <span class="label label-success">Due</span>
                    }
                    else
                    {  
                        <span class="label label-danger">Not Defined</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DESCRIPTION)
                </td>
                <td>
                    @if (item.KICKBACK_FROM == "1")
                    {
                    <span class="label label-success">Net Premium</span>
                    }
                    else if (item.KICKBACK_FROM == "2")
                    {
                    <span class="label label-success">Total Premium</span>
                    }
                    else
                    {
                    <span class="label label-danger">Not Defined</span> 
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.REQUEST_BY)
                </td>

            </tr>
              }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    @*<script src="~/Scripts/AssetUser/EditStaff.js"></script>*@
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}


@model PM.ModelsV.NewPRANAsset

@{
    ViewBag.Title = "New PRAN Asset";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                @ViewBag.Title
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">

                @using (Html.BeginForm("NewFridge", "AssetManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Code</span>
                                @Html.EditorFor(model => model.ASET_TAG, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "If not exist, left blank" } })
                                @Html.ValidationMessageFor(model => model.ASET_TAG, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Name</span>
                                @Html.EditorFor(model => model.ASET_CODE_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, onchange = "CopyToCode();" } })
                                @Html.ValidationMessageFor(model => model.ASET_CODE_NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Model</span>
                                @Html.EditorFor(model => model.ASET_MODEL, new { htmlAttributes = new { @class = "form-control", placeholder = "Model" } })
                                @Html.ValidationMessageFor(model => model.ASET_MODEL, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">PO</span>
                                @Html.EditorFor(model => model.ASET_PO_ENGINE, new { htmlAttributes = new { @class = "form-control", placeholder = "PO Number" } })
                                @Html.ValidationMessageFor(model => model.ASET_PO_ENGINE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">GRN</span>
                                @Html.EditorFor(model => model.ASET_GRN_CHASIS, new { htmlAttributes = new { @class = "form-control", placeholder = "GRN Number" } })
                                @Html.ValidationMessageFor(model => model.ASET_GRN_CHASIS, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Capacity</span>
                                @Html.EditorFor(model => model.ASET_CAPACITY, new { htmlAttributes = new { @class = "form-control", placeholder = "Capacity" } })
                                @Html.ValidationMessageFor(model => model.ASET_CAPACITY, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Price</span>
                                @Html.EditorFor(model => model.ASET_PRICE, new { htmlAttributes = new { @class = "form-control", placeholder = "Price" } })
                                @Html.ValidationMessageFor(model => model.ASET_PRICE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Reg Date</span>
                                @Html.EditorFor(model => model.ASET_REG_DATE, new { htmlAttributes = new { @class = "form-control", type = "date", required = "required" } })
                                @Html.ValidationMessageFor(model => model.ASET_REG_DATE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Picture</span>
                                <input type="file" name="file" id="file" class="form-control">
                                <p class="help-block">*.jpg,*.jpeg,*.png files only</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Year</span>
                                @Html.EditorFor(model => model.ASET_MFG_YEAR, new { htmlAttributes = new { @class = "form-control", type = "number", required = "required", placeholder = "Year" } })
                                @Html.ValidationMessageFor(model => model.ASET_MFG_YEAR, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Note</span>
                                @Html.EditorFor(model => model.ASET_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note(s)" } })
                                @Html.ValidationMessageFor(model => model.ASET_NOTE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Group</span>
                                @Html.DropDownListFor(model => model.ASET_GROUP, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_GROUP, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Business Unit</span>
                                @Html.DropDownList("ASET_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FindDepts();" })
                                @Html.ValidationMessage("ASET_BUSINESS", "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Department</span>
                                @Html.DropDownList("ASET_DEPARTMENT", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", name = "ASET_DEPARTMENT", id = "ASET_DEPARTMENT" })
                                @Html.ValidationMessageFor(model => model.ASET_DEPARTMENT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Area</span>
                                @Html.DropDownListFor(model => model.ASET_AREA, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_AREA, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Brand</span>
                                @Html.DropDownListFor(model => model.ASET_BRAND, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_BRAND, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Body</span>
                                @Html.DropDownListFor(model => model.ASET_BODY, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_BODY, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Fuel</span>
                                @Html.DropDownListFor(model => model.ASET_FUEL, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_FUEL, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Color</span>
                                @Html.DropDownListFor(model => model.ASET_COLOR, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_COLOR, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                                <a href="@Url.Action("Index","AssetManager")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="panel-footer">
                New PRAN Asset Entry
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/AssetManager/NewFridge.js"></script>
}

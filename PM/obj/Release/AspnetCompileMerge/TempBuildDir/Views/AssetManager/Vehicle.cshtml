@model PM.ModelsV.NewVehicleData


@{
    ViewBag.Title = "Vehicle";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}


<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                @ViewBag.Title
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">

                @using (Html.BeginForm("NewVehicle", "AssetManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Vehicle ID</span>
                                @Html.EditorFor(model => model.ID, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "If not exist, left blank" } })
                                @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Name</span>
                                @Html.EditorFor(model => model.NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, onchange = "CopyToCode();" } })
                                @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Name</span>
                                @Html.EditorFor(model => model.MODEL, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Model Name", autofocus = true, onchange = "CopyToCode();" } })
                                @Html.ValidationMessageFor(model => model.MODEL, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                                <a href="@Url.Action("Vehicle","AssetManager")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="panel-footer">
                New PRAN Asset Entry
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/AssetManager/NewFridge.js"></script>
}



@model PM.ModelsV.ItemVM
@{
    ViewBag.Title = "Item Master";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("NewItemMaster", "Item", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Item Name</span>
                        @Html.EditorFor(model => model.ITEM_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", autofocus = true, placeholder = "Item Name" } })
                        @Html.ValidationMessageFor(model => model.ITEM_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Item Code</span>
                        @Html.EditorFor(model => model.ITEM_CODE, new { htmlAttributes = new { @class = "form-control", placeholder = "Item Code", autofocus = true, required="required" } })
                        @Html.ValidationMessageFor(model => model.ITEM_CODE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                    <div class="btn-group">
                        <a href="@Url.Action("Index","Item")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        <a href="@Url.Action("NewItemMaster","Item")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        Item Name Entry
    </div>
</div>


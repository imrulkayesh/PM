@model PM.Model.A_PLEA
@using (Html.BeginForm()){
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.PLEA_ID)
    <div class="form-group">
        @Html.LabelFor(model => model.PLEA_DESCRIPTION,"Note", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.PLEA_DESCRIPTION, new { htmlAttributes = new { @class = "form-control" ,pleceholder="Note",required="required"} })
            @Html.ValidationMessageFor(model => model.PLEA_DESCRIPTION, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Update" class="btn btn-primary pull-left" />
        </div>
    </div>
</div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@model PM.Model.A_OWNR_BILL

@{
    ViewBag.Title = "Asset User Bill";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("ViewOldData", "AssetUserBill", new { Operation = "Search" }))
        {
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("_staffId", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = " Staff id", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="submit" class="viewAsset btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
        }
    </div>
    <div class="col-md-6">
    </div>
</div>
<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="col-md-2">
                <div class="form-group input-group">
                    <span class="input-group-addon">Staff Id</span>
                    @Html.EditorFor(model => model.BILL_OWNR, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.BILL_OWNR, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-1">
                <input type="button" class="btn4 btn btn-flat btn-primary" value="View" />
            </div>
            <div class="col-md-2">
                <div class="form-group input-group">
                    <span class="input-group-addon">Date</span>
                    @Html.EditorFor(model => model.BILL_DATE, new { htmlAttributes = new { @class = "form-control", type = "date", placeholder = "dd/MM/yyyy", required = "required" } })
                    @Html.ValidationMessageFor(model => model.BILL_DATE, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group input-group">
                    <span class="input-group-addon">Amount</span>
                    @Html.EditorFor(model => model.BILL_AMNT, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Bill Amount", required = "required" } })
                    @Html.ValidationMessageFor(model => model.BILL_AMNT, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">Note</span>
                    @Html.EditorFor(model => model.BILL_NOTE, new { htmlAttributes = new { @class = "form-control", type = "text", placeholder = "Bill Note" } })
                    @Html.ValidationMessageFor(model => model.BILL_NOTE, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <input type="text" id="userDetail" name="userDetail" readonly="readonly" class="form-control" placeholder="User Details" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="btn-group col-md-12">
                <a href="@Url.Action("Index","AssetUserBill")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                <a href="@Url.Action("Index","AssetUserBill")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                <button type="submit" id="CreateBill" class="btn btn-danger pull-right" disabled><i class="fa fa-save"></i> Pay</button>
            </div>
        </div>
        }
    </div>
    <div class="panel-footer">
        New Bill Entry
    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-heading">
        Old Bill Record
    </div>
    <div class="panel-body table-responsive">
        <table id="Old_Data" class="table table-borderd">
            <thead>
                <tr>
                    <th>
                        Staff Id
                    </th>
                    <th>
                        Payment Date
                    </th>
                    <th>
                        Amount
                    </th>
                    <th>
                        Staff Name
                    </th>
                    <th>
                        Note
                    </th>
                    <th>
                        Aset Id
                    </th>
                    <th>
                        Aset Name
                    </th>
                    <th>
                        Reg Date
                    </th>
                    <th>
                        Rcv Date
                    </th>
                    <th>
                        Return Date
                    </th>
                    <th>#</th>
                </tr>
            </thead>

        </table>
    </div>
    <div class="panel-footer">
        Old Bill Record
    </div>
</div>

@section scripts{
<script>
    $(document).ready(function () {
        $('.btn4').click(function () {

            var url = 'GetDeptUser';
            var BILL_OWNR = $('#BILL_OWNR').val();
            if (BILL_OWNR === "" || BILL_OWNR == "") {
                swal('Ohh..', 'Enter staff id', 'warning');
                return;
            }
            $.getJSON(url, { StaffId: BILL_OWNR }, function (response) {
                $('#userDetail').val(response.seco);
            });
            $('#CreateBill').prop('disabled', false);
            //loadTable(BILL_OWNR);
            var dataTable = $('#Old_Data').DataTable({
                "ajax": {
                    "url": "ViewOldDataJson/" + BILL_OWNR,
                    "type": "GET",
                    "datatype": "json"
                },
                "bDestroy": true,
                "columns": [
                               { "mData": "ownr_id" },
                               {
                                   "mData": "pmnt_date", "render": function (mData) {
                                       if (mData === null) return "";
                                       return moment(mData).format('DD/MM/YYYY');
                                   }
                               },
                               { "mData": "pmnt_amnt" },
                               { "mData": "ownr_name" },
                               { "mData": "pmnt_note" },
                               { "mData": "vhcl_id" },
                               { "mData": "vhcl_name" },
                               {
                                   "mData": "vhcl_rgdt", "render": function (mData) {
                                       if (mData === null) return "";
                                       return moment(mData).format('DD/MM/YYYY');
                                   }
                               },
                               {
                                   "mData": "ownr_rdat", "render": function (mData) {
                                       if (mData === null) return "";
                                       return moment(mData).format('DD/MM/YYYY');
                                   }
                               },
                               {
                                   "mData": "ownr_tdat", "render": function (mData) {
                                       if (mData === null) return "";
                                       return moment(mData).format('DD/MM/YYYY');
                                   }
                               },
                               {
                                   "data": "id",
                                   "render": function (data) {
                                       return `<div class="text-center"><a href="#" class="btn btn-info">Paid</a></div>`;
                                   }
                               }
                ],
                "language": { "emptyTable": "no data found" }, "width": "100%"
            });
        });
    });
</script>
}

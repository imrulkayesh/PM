@model PM.ModelsV.KickBackVM

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.INSURANCE_MST_ID)

   <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance Number</span>
                @Html.EditorFor(model => model.INSURANCE_NUMBER, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", @Readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INSURANCE_NUMBER, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
   <div class="row">

       @{
           var KickBackFrom = new List<SelectListItem>
              {
                        new SelectListItem { Value = "1", Text = "Net Premium" },
                        new SelectListItem { Value = "2", Text = "Total Premium" },
                    };
       }
       <div class="col-md-8">
           <div class="form-group input-group">
               <span class="input-group-addon">Discount From</span>
               @Html.DropDownList("KICKBACK_FROM", KickBackFrom, "--Select--", new { @class = "form-control select2", style = "width:100%;", required = "required" })
               @Html.ValidationMessage("KICKBACK_FROM", "", new { @class = "text-danger" })
           </div>
       </div>
   </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Discount Percentage (%)</span>
                @Html.EditorFor(model => model.KICK_BACK_PERCENTAGE, new { htmlAttributes = new { @class = "form-control", placeholder = "Claim Amount", autofocus = true, required = "required" } })
                @Html.ValidationMessageFor(model => model.KICK_BACK_PERCENTAGE, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Discount Status</span>
                @Html.DropDownListFor(model => model.KICK_BACK_STATUS, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", name = "KICK_BACK_STATUS", id = "KICK_BACK_STATUS" })
                @Html.ValidationMessageFor(model => model.KICK_BACK_STATUS, "", new { @class = "text-danger" })
            </div>
        </div>
        @*<div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Kick Back Status</span>
                @Html.DropDownList("KICK_BACK_STATUS", null, "--Select--", new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessage("KICK_BACK_STATUS", "", new { @class = "text-danger" })
            </div>
        </div>*@

    </div>

    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
        </div>
    </div>

    }



@model PM.ModelsV.InsuranceDetailVM
@{
    ViewBag.Title = "Insurance Detail";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("InsuranceDetail", "InsuranceManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">

                @{
                    var ItemName = new List<SelectListItem>
                                                                    {
                        new SelectListItem { Value = "1", Text = "Item 1" },
                        new SelectListItem { Value = "2", Text = "Item 2" },
                        new SelectListItem { Value = "3", Text = "Item 3" }
                    };
                }
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Item Name</span>
                        @Html.DropDownList("ITEM_ID", ItemName, "--Select--", new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("ITEM_ID", "", new { @class = "text-danger" })
                    </div>
                </div>
                @{
                    var LicenseType = new List<SelectListItem>
                                                                {
                        new SelectListItem { Value = "1", Text = "Policy-1" },
                        new SelectListItem { Value = "2", Text = "Policy-2" },
                        new SelectListItem { Value = "3", Text = "Policy-3" }
                    };
                }
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Insurance (Policy) Number</span>
                        @Html.DropDownList("INSURANCE_MST_ID", LicenseType, "--Select--", new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessage("INSURANCE_MST_ID", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Premium Date</span>
                        @Html.EditorFor(model => model.PREMIUM_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "MM/dd/yyyy" } })
                        @Html.ValidationMessageFor(model => model.PREMIUM_DATE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                @*<div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Insurance Premium Amount </span>
                        @Html.EditorFor(model => model.INSURANCE_PREMIUM, new { htmlAttributes = new { @class = "form-control", placeholder = "Mobile Number", autofocus = true, required = "required" } })
                        @Html.ValidationMessageFor(model => model.INSURANCE_PREMIUM, "", new { @class = "text-danger" })
                    </div>
                </div>*@
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">VAT</span>
                        @Html.EditorFor(model => model.VAT, new { htmlAttributes = new { @class = "form-control", placeholder = "Mobile Number", autofocus = true, required = "required" } })
                        @Html.ValidationMessageFor(model => model.VAT, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">STAMP</span>
                        @Html.EditorFor(model => model.STAMP, new { htmlAttributes = new { @class = "form-control", placeholder = "Mobile Number", autofocus = true, required = "required" } })
                        @Html.ValidationMessageFor(model => model.STAMP, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Remark</span>
                        @Html.EditorFor(model => model.REMARK, new { htmlAttributes = new { @class = "form-control", placeholder = "Remark", autofocus = true } })
                        @Html.ValidationMessageFor(model => model.REMARK, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                    <div class="btn-group">
                        <a href="@Url.Action("InsuranceDetail","InsuranceManager")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        <a href="@Url.Action("InsuranceDetail","InsuranceManager")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        Insurance Data Entry
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



@{
    ViewBag.Title = "PRAN Bike";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                @ViewBag.Title
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">

                @using (Html.BeginForm("PranBikeView", "ReportManager", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="col-md-12">
                        <div class="form-horizontal col-md-8">
                            <div class="form-group input-group">
                                <span class="input-group-addon">Business</span>
                                @Html.DropDownList("ASET_BUSINESS", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", onchange = "FromDept();" })
                                @Html.ValidationMessage("ASET_BUSINESS", "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group input-group">
                                <span class="input-group-addon">Department</span>
                                @Html.DropDownList("ASET_DEPARTMENT", Enumerable.Empty<SelectListItem>(), "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", onchange = "ClearAsset();" })
                                @Html.ValidationMessage("ASET_DEPARTMENT", "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group input-group">
                                <span class="input-group-addon">From Group</span>
                                @Html.DropDownList("ASET_GROUP", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FromAsset();" })
                                @Html.ValidationMessage("ASET_GROUP", "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group input-group">
                                <span class="input-group-addon">Vehicle</span>
                                @Html.DropDownList("ASET_ID", Enumerable.Empty<SelectListItem>(), "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                                @Html.ValidationMessage("ASET_ID", "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-horizontal col-md-4">                       
                            <div class="form-group">
                                <div class="col-md-10">
                                    <button type="submit" class="btn btn-primary pull-right"><span class="fa fa-cloud-download"></span> Download</button>
                                    <a href="@Url.Action("PranBike","ReportManager")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="panel-footer">
             Report Manager : PRAN Bike
            </div>
        </div>
    </div>
</div>

@section scripts{
<script src="~/Scripts/ReportManager/PranBike.js"></script>
}
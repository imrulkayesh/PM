@{
    ViewBag.Title = "Report Insurance List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div class="col-md-12">
    <div class="box box-info box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">Insurance List</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            @using (Html.BeginForm("Report_Insurance_List", "ReportManager"))
            {
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Benificiary (Company) Name</span>
                        @Html.DropDownList("COMPANY_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessage("COMPANY_ID", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Types of Insurance/Risk</span>
                        @Html.DropDownList("INSURANCE_TYPE_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessage("INSURANCE_TYPE_ID", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Insurance Company</span>
                        @Html.DropDownList("INSURANCE_COMPANY_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessage("INSURANCE_COMPANY_ID", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Discount Status</span>
                        @Html.DropDownList("KICK_BACK_STATUS", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessage("KICK_BACK_STATUS", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Claim Status</span>
                        @Html.DropDownList("CLAIM_STATUS", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessage("CLAIM_STATUS", "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="input-group">
                            <button type="submit" class="btn bg-olive btn-flat margin">Submit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>

@model IEnumerable<PM.ModelsV.UserGroupList>
@{
    ViewBag.Title = "User Group";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-10">
        <div class="box box-success box-solid">
            <div class="box-header with-border">
                <h3 class="box-title">Select User Group</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <!-- /.box-tools -->
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                @using (Html.BeginForm())
            {
                    <div class="form-group col-md-4">
                        @Html.Editor("USER_ID", new { htmlAttributes = new { @class = "form-control", placeholder = "User Id", required = "required" } })
                    </div>
                    <div class="form-group col-md-2">
                        <button type="submit" class="btn btn-primary">Select</button>
                    </div>
                    <div class="form-group col-md-4">
                        <p>@ViewBag.USER_ID - @ViewBag.USER_NAME</p>
                    </div>
                    <div class="form-group col-md-2">
                        <a href="@Url.Action("UserGroup","ApplicationUsers")" class="form-control btn btn-warning">Clear</a>
                    </div>
                }
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>
<div class="col-md-10">
    <div class="box box-primary box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">User Groups</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">

            @if (Model != null)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>USER NAME</th>
                            <th>GROUP ID</th>
                            <th>GROUP NAME</th>
                            <th>STATUS</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.USER_NAME</td>
                                <td>@item.GROUP_ID</td>
                                <td>@item.GROUP_NAME</td>
                                <td>
                                    @if (item.STATUS == true)
                                    {
                                        <i class="fa fa-check fa-1x text-success"> Active</i>
                                    }
                                    else if (item.STATUS == false)
                                    {
                                        <i class="fa fa-close fa-1x text-danger"> Disabled</i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-diamond fa-1x text-primary"> New</i>
                                    }
                                </td>
                                <td>
                                    <input type="submit" class="ActionMenu btn btn-primary" value="Action" data-url="@Url.Action("AR_Group", "ApplicationUsers",new { USER_ID=ViewBag.USER_ID,GROUP_TEXT=item.GROUP_ID })" />
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            }
            else
            {
                <p>No Record</p>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>

@section scripts{
    <script src="~/Scripts/ApplicationUsers/UserAction.js"></script>
}

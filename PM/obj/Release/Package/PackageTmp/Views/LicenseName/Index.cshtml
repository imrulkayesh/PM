@model IEnumerable<PM.ModelsV.LicenseVM>
@{
    ViewBag.Title = "License Name List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    @*<div class="col-md-6">
        @using (Html.BeginForm("Index", "LicenseName", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("License", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "License Name", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>
        }
    </div>*@
    <div class="col-md-12">
        <div class="btn-group margin">
            <a href="@Url.Action("NewLicense", "LicenseName")" class="btn btn-primary"> New License Name</a>
            <a href="@Url.Action("Index","LicenseName")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_NAME_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.APPLICATION_DAYS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NOTIFY_DAYS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMARKS)
                </th>

            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LICENSE_NAME_ID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LICENSE_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.APPLICATION_DAYS)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NOTIFY_DAYS)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.REMARKS)
                </td>

            </tr>
            }
        </tbody>
    </table>
</div>


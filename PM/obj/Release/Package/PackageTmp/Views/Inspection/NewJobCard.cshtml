@model PM.ModelsV.JobCard

@{
    ViewBag.Title = "New Job Card";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("NewJobCard", "Inspection",FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Asset</span>
                        @Html.DropDownListFor(model => model.JOBH_ASET, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", autofocus = true, onchange = "getInspection();" })
                        @Html.ValidationMessageFor(model => model.JOBH_ASET, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Inspection</span>
                        @Html.DropDownList("INSPH_ID", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "getInspectionItems();" })
                        @Html.ValidationMessageFor(model => model.INSPH_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Date</span>
                        @Html.EditorFor(model => model.JOBH_DATE, new { htmlAttributes = new { @class = "form-control", type="date", placeholder="dd/MM/yyyy" } })
                        @Html.ValidationMessageFor(model => model.JOBH_DATE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <input type="text" id="insdetail" disabled="disabled" class="form-control" placeholder="Inspection Details" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Job Vendor</span>
                        @Html.EditorFor(model => model.JOBH_VENDOR, new { htmlAttributes = new { @class = "form-control", required="required", placeholder= "Whorkshop (Max 50 Char)" } })
                        @Html.ValidationMessageFor(model => model.JOBH_VENDOR, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Recommendation</span>
                        @Html.EditorFor(model => model.JOBH_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder= "Note/Recommendation (Max 50 Char)", required = "required" } })
                        @Html.ValidationMessageFor(model => model.JOBH_NOTE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">User Pay</span>
                        @Html.EditorFor(model => model.JOBH_UPAY, new { htmlAttributes = new { @class = "form-control" ,placeholder="Deduction Amount"} })
                        @Html.ValidationMessageFor(model => model.JOBH_UPAY, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Insurance Pay</span>
                        @Html.EditorFor(model => model.JOBH_IPAY, new { htmlAttributes = new { @class = "form-control", placeholder = "Deduction Amount" } })
                        @Html.ValidationMessageFor(model => model.JOBH_IPAY, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Item Name</span>
                        @Html.DropDownList("JOBD_ITEM", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", onchange = "LastRate();" })
                        @Html.ValidationMessage("JOBD_ITEM", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Qty</span>
                        @Html.Editor("JOBD_JQTY", new { htmlAttributes = new { @class = "form-control", placeholder = "J Qty", type = "number" } })
                        @Html.ValidationMessage("JOBD_JQTY", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Rate</span>
                        @Html.Editor("JOBD_JRATE", new { htmlAttributes = new { @class = "form-control", placeholder = "J Rate", type = "number" } })
                        @Html.ValidationMessage("JOBD_JRATE", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Description</span>
                        @Html.Editor("JOBD_NOTE", new { htmlAttributes = new { @class = "form-control", placeholder = "Problem Description (Max 50 Char)" } })
                        @Html.ValidationMessage("JOBD_NOTE", "", new { @class = "text-danger" })
                        <span class="input-group-btn">
                            <button id="addItem" type="button" class="btn btn-primary"><i class="fa fa-plus"></i> Add</button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 form-group">
                    <input type="text" disabled="disabled" id="OldRec" class="form-control" placeholder="Item History" />
                </div>
            </div>
            <div class="box box-primary">
                <div id="DetailItem" class="table-responsive"></div>
            </div>
            <div class="row">
                <div class="btn-group col-md-12">
                    <a href="@Url.Action("JobCard","Inspection")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                    <a href="@Url.Action("NewJobCard","Inspection")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    <button type="submit" id="CreateJob" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Create Job Card</button>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        New Job Entry
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script src="~/Scripts/Inspection/NewJobCard.js"></script>
}

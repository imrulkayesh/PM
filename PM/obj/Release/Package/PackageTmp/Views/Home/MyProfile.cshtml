@model PM.ModelsV.UserProfile
@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div class="col-md-6">
    <!-- Profile Image -->
    <div class="box box-primary">
        <div class="box-body box-profile">
            <img class="profile-user-img img-responsive img-circle"
                 src="~/Images/ProfilePicture/@Session["UserId"] .jpg"
                 alt="User profile picture">
            <h3 class="profile-username text-center">@Model.USER_NAME</h3>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <p class="text-muted text-center">@Model.USER_DATE</p>
            @using (Html.BeginForm("MyProfile", "Home", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.USER_ID)
                <table class="table">
                    <tr>
                        <th>Email</th>
                        <td>@Html.EditorFor(model => model.USER_EMAIL, new { htmlAttributes = new { @class = "form-control" } })</td>
                    </tr>
                    <tr>
                        <th>Mobile</th>
                        <td>@Html.EditorFor(model => model.USER_MOBILE, new { htmlAttributes = new { @class = "form-control" } })</td>
                    </tr>
                    <tr>
                        <th>Password</th>
                        <td>@Html.PasswordFor(model => model.Password, htmlAttributes: new { @class = "form-control", placeholder = "Enter Password" })</td>
                    </tr>
                    <tr>
                        <th>Confirm Password</th>
                        <td>@Html.PasswordFor(model => model.Passwords, htmlAttributes: new { @class = "form-control", placeholder = "Re-enter Password" })</td>
                    </tr>
                    <tr>
                        <th>Upload Your Picture</th>
                        <td><input id="ProfileImage" type="file" name="ProfileImage" accept="image/jpeg" /></td>
                    </tr>
                </table>
                <input type="submit" class="btn btn-primary btn-block" value="Update">
            }
        </div>
        <!-- /.box-body -->
    </div>
</div>
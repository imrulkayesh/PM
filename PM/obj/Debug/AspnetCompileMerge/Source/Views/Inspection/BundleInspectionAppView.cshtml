@model IEnumerable<PM.ModelsV.BundleInspectionAppD>

@{
    Layout = null;
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.INSPD_NOTE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ASET_CODE_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.OWNR_USER)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ITEM_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPD_IQTY)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPD_IRATE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPH_IUSER)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPH_DATE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPH_NOTE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.INSPH_ID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DEPARTMENT_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AREA_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MILEAGE)
        </th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.INSPD_NOTE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ASET_CODE_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.OWNR_USER)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ITEM_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPD_IQTY)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPD_IRATE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPH_IUSER)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPH_DATE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPH_NOTE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.INSPH_ID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DEPARTMENT_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AREA_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MILEAGE)
        </td>     
    </tr>
}

</table>

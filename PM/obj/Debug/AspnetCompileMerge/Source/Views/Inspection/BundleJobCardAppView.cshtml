@model IEnumerable<PM.ModelsV.BundleJobcardAppD>

@{
    Layout = null;
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.JOBD_NOTE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ASET_CODE_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.OWNR_USER)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ITEM_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBD_IQTY)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBD_IRATE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBH_VENDOR)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBH_DATE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBH_NOTE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBH_ID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DEPARTMENT_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AREA_NAME)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JOBH_MILEAGE)
        </th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.JOBD_NOTE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ASET_CODE_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.OWNR_USER)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ITEM_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBD_IQTY)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBD_IRATE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBH_VENDOR)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBH_DATE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBH_NOTE)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBH_ID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DEPARTMENT_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AREA_NAME)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.JOBH_MILEAGE)
        </td>     
    </tr>
}

</table>

@model IEnumerable<PM.ModelsV.LicenseLocationVM>
@{
    ViewBag.Title = "License Location";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="btn-group margin">
            <a href="@Url.Action("NewLicenseLocation", "License")" class="btn btn-primary"> New Location</a>
            <a href="@Url.Action("LicenseLocation","License")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LIC_LOCATION_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LOCATION_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SHORT_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ADDRESS)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.LIC_LOCATION_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LOCATION_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SHORT_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ADDRESS)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>






@model PM.ModelsV.LicenseCompanyVM
@{
    ViewBag.Title = "New License Company";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("NewLicenseCompany", "License", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Company Name</span>
                        @Html.EditorFor(model => model.COMPANY_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", autofocus = true, placeholder = "Company Name" } })
                        @Html.ValidationMessageFor(model => model.COMPANY_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Short Name</span>
                        @Html.EditorFor(model => model.SHORT_NAME, new { htmlAttributes = new { @class = "form-control", placeholder = "Short Name", autofocus = true } })
                        @Html.ValidationMessageFor(model => model.SHORT_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                    <div class="btn-group">
                        <a href="@Url.Action("LicenseCompany","License")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        <a href="@Url.Action("NewLicenseCompany","License")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        Company Name Entry
    </div>
</div>




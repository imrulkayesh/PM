
@{
    ViewBag.Title = "License Dashboard";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-success">
    @*<div class="panel-heading">
            *if the value is different from reports, you will take reports data are right.
        </div>*@
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <div class="card card-secondary" style="background: #349feb  !important;">
                    <div class="card-body skew-shadow" style="padding: 1.25rem;">
                        <h1 style="color: white !important;">
                          @Model.updateDate.TOTAL_LICENSE
                        </h1>
                        <h5 class="op-8" style="color: white !important; line-height: 2; font-size: 17px;">Total License</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-secondary" style="background: #349feb !important;">
                    <div class="card-body skew-shadow" style="padding: 1.25rem;">
                        <h1 style="color: white !important;">
                            @Model.updateDate.TOTAL_ENTRY_LOCATION / @Model.updateDate.TOTAL_LOCATION
                        </h1>
                        <h5 class="op-8" style="color: white !important; line-height: 2; font-size: 17px;">Total Location</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-secondary" style="background: #349feb !important;">
                    <div class="card-body skew-shadow" style="padding: 1.25rem;">
                        <h1 style="color: white !important;">
                            @Model.updateDate.TOTAL_ENTRY_COMPANY / @Model.updateDate.TOTAL_COMPANY
                        </h1>
                        <h5 class="op-8" style="color: white !important; line-height: 2; font-size: 17px;">Total Company</h5>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-5">
                <div class="box box-danger">
                    <div class="box-header with-border">
                        <h3 class="box-title">Location & Company Wise License Count</h3>
                        <div class="box-tools pull-right">
                            <a href="#"><i class="fa fa-refresh"></i></a>
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-box-tool" data-widget="remove">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body no-padding">
                        @*<h4></h4>*@
                        <table id="scrollNbuttonDT" class="table">
                            <thead>
                                <tr style="background-color:darkseagreen">
                                    <th>
                                        Location
                                    </th>
                                    <th>
                                        Company
                                    </th>
                                    <th>
                                        Total License
                                    </th>
                                    <th>
                                        Details
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.locationCompanyWiseLicenseCount)
                                {
                                    <tr>
                                        <td>
                                            @item.LOCATION_NAME
                                        </td>
                                        <td>
                                            @item.COMPANY_NAME
                                        </td>
                                        <td>
                                            @item.Total
                                        </td>
                                        <td>
                                            <input type="submit" class="btn4 btn btn-flat btn-primary" value="Details" data-url="@Url.Action("ViewLocationWisetDetails", "Summary", new { id = item.COMPANY_ID, LId = item.LIC_LOCATION_ID })" />
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!--/.box -->
            </div>

            <div class="col-md-7">
                <div class="box box-danger">
                    <div class="box-header with-border">
                        @*<h3 class="box-title">Update: @Convert.ToDateTime(Model.updateDate.IQUMA_DATE).ToString("dd/MM/yyyy")</h3>*@
                        <h3 class="box-title">Upcomming Expire List</h3>
                        <div class="box-tools pull-right">
                            <a href="@Url.Action("Pro_Iquma_Expire_List", "Summary")" class="btn btn-box-tool"><i class="fa fa-refresh"></i></a>
                            <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                <i class="fa fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-box-tool" data-widget="remove">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body no-padding">
                        @*<h4>Upcomming Expire List</h4>*@
                        <table id="generalDT" class="table">
                            <thead>
                                <tr style="background-color:darkseagreen">
                                    <th>
                                        License Id
                                    </th>
                                    <th>
                                        Location
                                    </th>
                                    <th>
                                        License Holder Mobile
                                    </th>
                                    <th>
                                        License Number
                                    </th>
                                    <th>
                                        Issue Date
                                    </th>
                                    <th>
                                        Expire Date
                                    </th>
                                    <th>
                                        Remaining
                                    </th>
                                    <th>
                                        Details
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.licenseExpireInformation)
                                {
                                    <tr>
                                        <td>
                                            @item.LICENSE_ID
                                        </td>
                                        <td>
                                            @item.LOCATION_NAME
                                        </td>
                                        <td>
                                            @item.LICENSE_HOLDER_MOBILE
                                        </td>
                                        <td>
                                            @item.LICENSE_NUMBER
                                        </td>
                                        <td>
                                            @item.ISSUE_DATE
                                        </td>
                                        <td>
                                            @item.EXPIRE_DATE
                                        </td>
                                        <td>
                                            @item.REMAINING
                                        </td>
                                        <td>
                                            <input type="submit" class="btn4 btn btn-flat btn-primary" value="Details" data-url="@Url.Action("ViewLicenseWisetDetails", "Summary", new { id = item.LICENSE_ID })" />
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!--/.box -->
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog" style="max-width: 1300px; width: 1300px;">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->



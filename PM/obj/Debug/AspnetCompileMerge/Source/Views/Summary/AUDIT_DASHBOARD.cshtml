@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="~/Scripts/DashPlugin/loader.js"></script>
    <script type="text/javascript" src="~/Scripts/DashPlugin/ModalBox.js"></script>
    <script src="~/Scripts/DashPlugin/MyPie.js"></script>
    <script type="text/javascript">
        MakeMy3DPieChart('AUDIT_TASK_STATUS_DATA', 'Audit Task Status', Task_Status_Data)
        MakeMySlicePieChart('AUDIT_REPORT_STATUS', 'Audit Report Status', Report_Status_Data)
        MakeMyHolePieChart('AUDIT_REPORT_SENT_SUM', 'Report Sent Status', Audit_Data)
        MakeMyMaterialBarChart('CURRENT_LAST_MONTH_REPORT_SUM', 'Total Reports – Current Month vs. Last Month', '', 'Current_Last')
        MakeMyMaterialBarChart('COMPAY_GROUP_WISE_REPORT_SUM', 'Company Group Wise Total Report', '', 'Company_Group_Wise')
    </script>

    <script>
        document.querySelectorAll('.counter').forEach(counter => {

            let target = parseFloat(counter.dataset.value) || 0;
            let count = 0;
            let speed = target / 50;

            function update() {
                count += speed;

                if (count >= target) {
                    counter.innerText = formatNumber(target);
                } else {
                    counter.innerText = formatNumber(Math.floor(count));
                    requestAnimationFrame(update);
                }
            }

            update();
        });

        function formatNumber(num) {
            return new Intl.NumberFormat().format(num);
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll('.dual-circle').forEach(function (el) {

                var thisPercent = parseFloat(el.getAttribute('data-this')) || 0;
                var lastPercent = parseFloat(el.getAttribute('data-last')) || 0;
                var growth = parseFloat(el.getAttribute('data-growth')) || 0;

                var thisCircle = el.querySelector('.this-progress');
                var lastCircle = el.querySelector('.last-progress');
                var mainText = el.querySelector('.main-percent');

                var outerRadius = 50;
                var innerRadius = 40;

                var outerCircumference = 2 * Math.PI * outerRadius;
                var innerCircumference = 2 * Math.PI * innerRadius;

                thisCircle.style.strokeDasharray = outerCircumference;
                thisCircle.style.strokeDashoffset = outerCircumference;

                lastCircle.style.strokeDasharray = innerCircumference;
                lastCircle.style.strokeDashoffset = innerCircumference;

                // Auto color logic
                if (growth >= 0) {
                    thisCircle.style.stroke = "#27ae60"; // green
                    mainText.style.color = "#27ae60";
                } else {
                    thisCircle.style.stroke = "#e74c3c"; // red
                    mainText.style.color = "#e74c3c";
                }

                setTimeout(function () {

                    thisCircle.style.strokeDashoffset =
                        outerCircumference - (thisPercent / 100) * outerCircumference;

                    lastCircle.style.strokeDashoffset =
                        innerCircumference - (lastPercent / 100) * innerCircumference;

                }, 200);

            });

        });
    </script>


}










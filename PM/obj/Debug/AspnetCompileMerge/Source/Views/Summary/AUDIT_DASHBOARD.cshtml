            // Manual Descending Sort by TOTAL_REPORT
            for (int i = 0; i < rankedAuditors.Count - 1; i++)
            {
                for (int j = i + 1; j < rankedAuditors.Count; j++)
                {
                    if (rankedAuditors[i].TOTAL_REPORT < rankedAuditors[j].TOTAL_REPORT)
                    {
                        var temp = rankedAuditors[i];
                        rankedAuditors[i] = rankedAuditors[j];
                        rankedAuditors[j] = temp;

@model IEnumerable<PM.ModelsV.ClaimVM>
@{
    ViewBag.Title = "Claim Receive";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("InsuranceMaster", "InsuranceManager", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("Insurance", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Insurance Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("ClaimList","InsuranceManager")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>

                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_NUMBER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_LOCATION)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LOSS_ITEM)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INS_AMT_LOSS_ITEM)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_RECEIVE_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_AMOUNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CLAIM_STATUS_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSURANCE_TYPE_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INS_COMPANY_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMARK)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>
                    <div class="input-group-btn">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                            Action
                            <span class="fa fa-caret-down"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <input type="submit" class="FileUp form-control btn btn-flat btn-primary" value="Claim Receive" data-url="@Url.Action("ClaimReceive","InsuranceManager", new { id= item.CLAIM_ID})" />
                            </li>
                        </ul>
                    </div>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_DATE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_NUMBER)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.COMPANY_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_LOCATION)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LOSS_ITEM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INS_AMT_LOSS_ITEM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_RECEIVE_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_AMOUNT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CLAIM_STATUS_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSURANCE_TYPE_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INS_COMPANY_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.REMARK)
                </td>

            </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}


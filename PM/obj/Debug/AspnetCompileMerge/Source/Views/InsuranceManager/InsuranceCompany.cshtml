    </div>*@
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewInsuranceCompany", "InsuranceManager")" class="btn btn-primary"> New Insurance Company</a>
            <a href="@Url.Action("InsuranceCompany","InsuranceManager")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>

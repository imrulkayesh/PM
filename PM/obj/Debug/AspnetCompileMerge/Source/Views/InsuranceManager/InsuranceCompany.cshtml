        @using (Html.BeginForm("InsuranceCompany", "InsuranceManager", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("Insurance", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Insurance Company Name", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>

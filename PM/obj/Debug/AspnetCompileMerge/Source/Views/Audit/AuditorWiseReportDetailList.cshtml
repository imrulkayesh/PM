@model IEnumerable<PM.ModelsV.AuditReportDetailsListVM>

@{
    ViewBag.Title = "Auditor Wise Report Detail List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}


<div class="col-md-12">
    <div class="box box-info box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">Auditor Wise Report List</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            @using (Html.BeginForm("AuditorWiseReportDetailList", "Audit"))
            {
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Auditor Name</span>
                            @Html.DropDownList("AUDITOR_STAFF_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("AUDITOR_STAFF_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Report Status</span>
                            @Html.DropDownList("REPORT_STATUS_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("REPORT_STATUS_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Task Status</span>
                            @Html.DropDownList("TASK_STATUS", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("TASK_STATUS", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="input-group">
                            <button type="submit" class="btn bg-olive btn-flat margin">Submit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>



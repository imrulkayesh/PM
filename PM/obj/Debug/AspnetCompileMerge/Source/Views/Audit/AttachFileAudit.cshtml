@using (Html.BeginForm("AttachFileAudit", "Audit", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div>
        @Html.Hidden("TRN_ID")

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Add Files</span>

                <input type="file"
                       name="files"
                       id="files"
                       class="form-control"
                       multiple
                       required />
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10">
                <button type="submit" class="btn btn-danger pull-left">
                    <i class="fa fa-save"></i> Upload
                </button>
            </div>
        </div>

    </div>
}

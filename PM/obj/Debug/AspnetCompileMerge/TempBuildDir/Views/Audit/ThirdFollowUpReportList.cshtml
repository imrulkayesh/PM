@model IEnumerable<PM.ModelsV.AuditReportFirstFollowUpVM>
@{
    ViewBag.Title = "Third Follow Up Report List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                @*<th>#</th>*@
                <th>
                    @Html.DisplayNameFor(model => model.AUDIT_RPT_FOLLOWUP_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDIT_RPT_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FOLLOWUP_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TOTAL_FINDINGS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ACTION_FINDINGS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NO_ACTION_FINDINGS)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.ACTION_PERCENTAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RISK_TYPE_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RISK_MITIGATION_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RISK_MITIGATION_MARKS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REPLY_PERSON)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.RESPONSIBLE_DEPT_HEAD)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMARKS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SIGNIFICANT_GAP)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FOLLOWUP_REQUIREMENT_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CDU)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CDT)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @*<td>
                            <div class="input-group-btn">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                    Action
                                    <span class="fa fa-caret-down"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a href="@Url.Action("EditAuditReportFirstFollowUp", "Audit", new { id = item.AUDIT_RPT_FOLLOWUP_ID })" , class="btn btn-flat btn-info">Edit</a>
                                    </li>
                                </ul>
                            </div>
                        </td>*@
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDIT_RPT_FOLLOWUP_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDIT_RPT_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FOLLOWUP_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TOTAL_FINDINGS)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ACTION_FINDINGS)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NO_ACTION_FINDINGS)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ACTION_PERCENTAGE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RISK_TYPE_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RISK_MITIGATION_NAME)
                    </td>
                    <td>
                        @string.Format("{0:N}", item.RISK_MITIGATION_MARKS)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REPLY_PERSON)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.RESPONSIBLE_DEPT_HEAD)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMARKS)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SIGNIFICANT_GAP)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FOLLOWUP_REQUIREMENT_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CDU)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CDT)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @*<script src="~/Scripts/Audit/_Update.js"></script>*@
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}


@model PM.ModelsV.ClaimVM

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.INSURANCE_MST_ID)

    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance Number</span>
                @Html.EditorFor(model => model.INSURANCE_NUMBER, new { htmlAttributes = new { @class = "form-control", placeholder = "License Number", autofocus = true, required = "required", @Readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INSURANCE_NUMBER, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Date</span>
                @Html.EditorFor(model => model.CLAIM_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "MM/dd/yyyy" } })
                @Html.ValidationMessageFor(model => model.CLAIM_DATE, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Type</span>
                @Html.DropDownListFor(model => model.CLAIM_TYPE_LIST, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.CLAIM_TYPE_LIST, "", new { @class = "text-danger" })
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Loss Items</span>
                @Html.EditorFor(model => model.LOSS_ITEM, new { htmlAttributes = new { @class = "form-control", placeholder = "Loss Items", autofocus = true, required = "required" } })
                @Html.ValidationMessageFor(model => model.LOSS_ITEM, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Location</span>
                @Html.EditorFor(model => model.CLAIM_LOCATION, new { htmlAttributes = new { @class = "form-control", placeholder = "Claim Location", autofocus = true, required = "required" } })
                @Html.ValidationMessageFor(model => model.CLAIM_LOCATION, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-7">
            <div class="form-group input-group">
                <span class="input-group-addon">Insured Amount for Loss Item</span>
                @Html.EditorFor(model => model.INS_AMT_LOSS_ITEM, new { htmlAttributes = new { @class = "form-control", placeholder = "Insurance Amount", autofocus = true, required = "required"} })
                @Html.ValidationMessageFor(model => model.INS_AMT_LOSS_ITEM, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-5">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Amount</span>
                @Html.EditorFor(model => model.CLAIM_AMOUNT, new { htmlAttributes = new { @class = "form-control", placeholder = "Claim Amount", autofocus = true, required = "required" } })
                @Html.ValidationMessageFor(model => model.CLAIM_AMOUNT, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Insured Amount</span>
                @Html.EditorFor(model => model.INSURANCE_AMOUNT, new { htmlAttributes = new { @class = "form-control", placeholder = "Insurance Amount", autofocus = true, required = "required", @Readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INSURANCE_AMOUNT, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Status</span>
                @Html.DropDownListFor(model => model.CLAIM_STATUS_LIST, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.CLAIM_STATUS_LIST, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Remark</span>
                @Html.EditorFor(model => model.REMARK, new { htmlAttributes = new { @class = "form-control", placeholder = "Remark", autofocus = true } })
                @Html.ValidationMessageFor(model => model.REMARK, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
        </div>
    </div>

}



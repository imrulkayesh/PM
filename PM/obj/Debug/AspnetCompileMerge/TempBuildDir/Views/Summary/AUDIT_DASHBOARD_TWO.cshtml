@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript" src="~/Scripts/DashPlugin/loader.js"></script>
    <script type="text/javascript" src="~/Scripts/DashPlugin/ModalBox.js"></script>
    <script src="~/Scripts/DashPlugin/MyPie.js"></script>
    <script type="text/javascript">
        MakeMy3DPieChart('AUDIT_TASK_STATUS_DATA', 'Audit Task Status', Task_Status_Data)
        MakeMySlicePieChart('AUDIT_REPORT_STATUS', 'Audit Report Status', Report_Status_Data)
        MakeMyHolePieChart('AUDIT_REPORT_SENT_SUM', 'Report Sent Status', Audit_Data)
        MakeMyMaterialBarChart('CURRENT_LAST_MONTH_REPORT_SUM', 'Total Reports – Current Month vs. Last Month', '', 'Current_Last')
        MakeMyMaterialBarChart('COMPAY_GROUP_WISE_REPORT_SUM', 'Company Group Wise Total Report', '', 'Company_Group_Wise')
    </script>
}









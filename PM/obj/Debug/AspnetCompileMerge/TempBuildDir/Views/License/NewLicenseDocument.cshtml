@model PM.ModelsV.LicenseDocumnetVM
@{
    ViewBag.Title = "New License Document";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("NewLicenseDocument", "License", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">License Name</span>
                    @Html.DropDownListFor(model => model.LICENSE_NAME_ID, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                    @Html.ValidationMessageFor(model => model.LICENSE_NAME_ID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">Document Name</span>
                    @Html.EditorFor(model => model.DOCUMENT_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "License Document Name" } })
                    @Html.ValidationMessageFor(model => model.DOCUMENT_NAME, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">Days</span>
                    @Html.EditorFor(model => model.DAYS, new { htmlAttributes = new { @class = "form-control",  placeholder = "Required Days" } })
                    @Html.ValidationMessageFor(model => model.DAYS, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Remark</span>
                        @Html.EditorFor(model => model.REMARKS, new { htmlAttributes = new { @class = "form-control", placeholder = "" } })
                        @Html.ValidationMessageFor(model => model.REMARKS, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                    <div class="btn-group">
                        <a href="@Url.Action("Index","License")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        <a href="@Url.Action("NewLicenseDocument","License")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        License Document Name Entry
    </div>
</div>


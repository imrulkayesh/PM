@model IEnumerable<PM.ModelsV.UserMenuList>
@{
    ViewBag.Title = "User Menu";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <div class="box box-success box-solid">
            <div class="box-header with-border">
                <h3 class="box-title">Select User Menu</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <!-- /.box-tools -->
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                @using (Html.BeginForm())
            {
                    <div class="form-group col-md-4">
                        @Html.Editor("USER_ID", new { htmlAttributes = new { @class = "form-control", placeholder = "User Id", required = "required" } })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.DropDownList("MENUC_ID", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                    </div>
                    <div class="form-group col-md-4">
                        <button type="submit" class="btn btn-primary">Select</button>
                    </div>
                }
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
    <div class="col-md-6">
        <div class="box box-warning box-solid">
            <div class="box-header with-border">
                <h3 class="box-title">Selected Menu</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <!-- /.box-tools -->
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                @using (Html.BeginForm("AR_Menu", "ApplicationUsers", FormMethod.Post))
            {
                    <div class="form-group col-md-4">
                        @Html.Editor("MENUC_TEXT", new { htmlAttributes = new { @class = "form-control", placeholder = "Menu Id", required = "required", @readonly = "readonly" } })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.Editor("USER_TEXT", new { htmlAttributes = new { @class = "form-control", placeholder = "User Id", required = "required", @readonly = "readonly" } })
                    </div>
                    <div class="form-group col-md-4">
                        <button type="submit" class="btn btn-warning">Action</button>
                    </div>
                }
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>
<div class="col-md-12">
    <div class="box box-primary box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">User Menu</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">

            @if (Model != null)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>USER NAME</th>
                            <th>PARENT MENU</th>
                            <th>MENU ID</th>
                            <th>MENU NAME</th>
                            <th>ACCESS ROLE</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.USER_NAME</td>
                                <td>@item.MENUP_NAME</td>
                                <td>@item.MENUC_ID</td>
                                <td>@item.MENUC_NAME</td>
                                <td>@item.MENUC_ROLE</td>
                                <td>
                                    @if (item.STATUS == true)
                                    {
                                        <i class="fa fa-check fa-2x text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-close fa-2x text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            }
            else
            {
                <p>No Record</p>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>

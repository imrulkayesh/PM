@model IEnumerable<PM.ModelsV.JobCardView>

@{
    ViewBag.Title = "Job Card Approval";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_ASET)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_OWNR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_DEPARTMENT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_AREA)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_MILEAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_TYPE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_VENDOR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_IPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_UPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_CPAY)
                </th>
                <th>#</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_ASET)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_OWNR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_DEPARTMENT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_AREA)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_MILEAGE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_TYPE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_VENDOR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_NOTE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_IPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_UPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_CPAY)
                    </td>
                    <td>
                        <a href="@Url.Action("JobCardAppDetail", "Inspection", new { id=item.JOBH_ID, AsetId =item.JOBH_ASET_ID, aset=item.JOBH_ASET})" class="btn btn-sm btn-danger">Find</a>
                        <input type="submit" class="FileDn btn btn-flat btn-primary" value="View" data-url="@Url.Action("ViewJobCard", "Inspection", new { id = item.JOBH_ID })" />
                        <a href="@Url.Action("DownloadAttachFile", "Inspection", new { id = item.JOBH_ID })" , class="btn btn-flat btn-primary">Download File</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" id="pvModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

@section scripts{
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}

@model IEnumerable<PM.ModelsV.InspectionView>

@{
    ViewBag.Title = "Inspections";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Inspections", "Inspection", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("InspectionNumber", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Inspection Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
                <!-- /btn-group -->
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewInspection", "Inspection")" class="btn btn-success"> New Inspection</a>
            <a href="@Url.Action("NewBundleInspection", "Inspection")" class="btn btn-primary"> Bundle Inspection</a>
            <a href="@Url.Action("Inspections","Inspection")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_ASET)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_OWNR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_DEPARTMENT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_AREA)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_IUSER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MILEAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPH_TYPE)
                </th>
                <th>#</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th>
                        @Html.DisplayFor(modelItem => item.INSPH_ID)
                    </th>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_ASET)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_OWNR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_DEPARTMENT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_AREA)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_IUSER)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MILEAGE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.INSPH_TYPE)
                    </td>
                    <td>
                        <input type="submit" class="btn4 btn btn-flat btn-primary" value="View" data-url="@Url.Action("ViewInspection", "Inspection", new { id = item.INSPH_ID })" />
                        <input type="submit" class="FileUp btn btn-flat btn-primary" value="Attach File" data-url="@Url.Action("AttachFile", "Inspection", new { id = item.INSPH_ID })" />
                        <a href="@Url.Action("DownloadAttachFile", "Inspection", new { id = item.INSPH_ID })" , class="btn btn-flat btn-primary">Download File</a>

                        <a href="@Url.Action("EditInspection", "Inspection", new { id = item.INSPH_ID })" , class="btn btn-flat btn-info">Edit</a>

                        @using (Html.BeginForm("SubmiInsp", "Inspection", new { id = item.INSPH_ID }))
                {
                            <input type="submit" class="btn btn-success btn-flat" value="Submit" />
                        }
                        @using (Html.BeginForm("DelIns", "Inspection", new { id = item.INSPH_ID }))
                {
                            <input type="submit" class="btn btn-danger btn-flat" value="Del" />
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

    <div class="modal fade" id="pvModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header btn-primary">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h5 class="modal-title">Action</h5>
                </div>
                <div class="modal-body" id="modalContainer">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>
    <!-- /.modal -->

    @section scripts{
        <script src="~/Scripts/Common/ConfirmBox.js"></script>
    }

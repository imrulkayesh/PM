@model IEnumerable<PM.ModelsV.InspectionD>

    <table class="table table-bordered table-striped table-condensed">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_LINE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_ITEM)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_ITEM_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_IQTY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_IRATE)
                </th>
                <th>
                    Amount
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.INSPD_NOTE)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_LINE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_ITEM)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_ITEM_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_IQTY)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_IRATE)
                </td>
                <td>
                    @{
                    decimal  Amount = item.INSPD_IQTY * item.INSPD_IRATE ?? 0;
                    }
                    @Amount
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.INSPD_NOTE)
                </td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2"></th>
                <th colspan="2">@ViewBag.INSPH</th>
                <th style="text-decoration:underline">Amount: </th>
                <th style="text-decoration:underline">@ViewBag.IAmount </th>
            </tr>
        </tfoot>
    </table>

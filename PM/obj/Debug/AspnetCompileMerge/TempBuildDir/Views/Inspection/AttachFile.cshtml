@using (Html.BeginForm("AttachFile", "Inspection", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div>
        @Html.Hidden("TRN_ID")
        <p style="color:red">Once you upload, you can't delete/edit files.</p>
        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Add a File</span>
                <input type="file" name="file" id="file" class="form-control" required>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-10">
                <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Upload</button>
            </div>
        </div>
    </div>
}

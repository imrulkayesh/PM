@model PM.ModelsV.StaffIquma

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.OWNR_ID)

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Staff NID</span>
                @Html.EditorFor(model => model.OWNR_NAME, new { htmlAttributes = new { @class = "form-control", required = "required",@readonly="readonly" } })
                @Html.ValidationMessageFor(model => model.OWNR_NAME, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Expire Date</span>
                @Html.EditorFor(model => model.OWNR_NDATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "dd/MM/yyyy" } })
                @Html.ValidationMessageFor(model => model.OWNR_NDATE, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-10">
                <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>

}

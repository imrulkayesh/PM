@model PM.ModelsV.StaffVM

@{
    ViewBag.Title = "New Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("NewStaff", "AssetUser", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Staff Id</span>
                        @Html.EditorFor(model => model.OWNR_TEXT, new { htmlAttributes = new { @class = "form-control", placeholder = "Staff Id", autofocus = true, @id = "staff", @onfocusout = "onClick(event);" } })
                        @Html.ValidationMessageFor(model => model.OWNR_TEXT, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Staff Name</span>
                        @Html.EditorFor(model => model.OWNR_USER, new { htmlAttributes = new { @class = "form-control", @id = "name", @readonly = "readonly", required = "required", placeholder = "Staff Name" } })
                        @Html.ValidationMessageFor(model => model.OWNR_USER, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Designation</span>
                        @Html.EditorFor(model => model.OWNR_DESG, new { htmlAttributes = new { @class = "form-control", @id = "desg", @readonly = "readonly", placeholder = "Designation" } })
                        @Html.ValidationMessageFor(model => model.OWNR_DESG, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Iquma</span>
                        @Html.EditorFor(model => model.OWNR_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Iquma Number" } })
                        @Html.ValidationMessageFor(model => model.OWNR_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Expire Date</span>
                        @Html.EditorFor(model => model.OWNR_NDATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "MM/dd/yyyy" } })
                        @Html.ValidationMessageFor(model => model.OWNR_NDATE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Mobile</span>
                        @Html.EditorFor(model => model.OWNR_CONT, new { htmlAttributes = new { @class = "form-control", @id = "mob", @readonly = "readonly", required = "required", placeholder = "Mobile No" } })
                        @Html.ValidationMessageFor(model => model.OWNR_CONT, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Email</span>
                        @Html.EditorFor(model => model.OWNR_EMAIL, new { htmlAttributes = new { @class = "form-control", @id = "mail", placeholder = "Email" } })
                        @Html.ValidationMessageFor(model => model.OWNR_EMAIL, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Address</span>
                        @Html.EditorFor(model => model.OWNR_ADDR, new { htmlAttributes = new { @class = "form-control", @id = "addr", @readonly = "readonly", required = "required", placeholder = "Address" } })
                        @Html.ValidationMessageFor(model => model.OWNR_ADDR, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Note</span>
                        @Html.EditorFor(model => model.OWNR_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note" } })
                        @Html.ValidationMessageFor(model => model.OWNR_NOTE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Passport Number</span>
                        @Html.EditorFor(model => model.OWNR_PASSPORT_NUMBER, new { htmlAttributes = new { @class = "form-control",  placeholder = "Passport Number" } })
                        @Html.ValidationMessageFor(model => model.OWNR_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Passport Expire Date</span>
                        @Html.EditorFor(model => model.OWNR_PASSPORT_EDATE, new { htmlAttributes = new { @class = "form-control",  placeholder = "MM/dd/yyyy" } })
                        @Html.ValidationMessageFor(model => model.OWNR_PASSPORT_EDATE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Staff Type</span>
                        @Html.DropDownListFor(model => model.OWNR_STYPE, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        @Html.ValidationMessageFor(model => model.OWNR_STYPE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Area</span>
                        @Html.DropDownListFor(model => model.OWNR_AREA, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessageFor(model => model.OWNR_AREA, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Business</span>
                        @Html.DropDownList("OWNR_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "getDeptList();" })
                        @Html.ValidationMessage("OWNR_BUSINESS", "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group input-group">
                        <span class="input-group-addon">Dept</span>
                        @Html.DropDownListFor(model => model.OWNR_DEPT, Enumerable.Empty<SelectListItem>
                            (), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        @Html.ValidationMessageFor(model => model.OWNR_DEPT, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                    <div class="btn-group">
                        <a href="@Url.Action("Staff","AssetUser")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                        <a href="@Url.Action("NewStaff","AssetUser")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="panel-footer">
        New Staff Entry
    </div>
</div>
@section scripts{
<script src="~/Scripts/AssetUser/NewOutlet.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script>
    function onClick(e) {
        e.preventDefault();
        var url = '/AssetUser/staffChecker';
        var id = $('#staff').val();
        if (id.length > 3) {
            $.getJSON(url, { staff: id }, function (response) {
                debugger;
                //console.log(response);
                if (response.STATUS == 1) {
                  
                    $('#name').val(response.OWNR_USER);
                    $('#desg').val(response.OWNR_DESG);
                    $('#mob').val(response.OWNR_CONT);
                    $('#mail').val(response.OWNR_EMAIL);
                    $('#addr').val(response.OWNR_ADDR);
                    swal({
                        text: "Data Loaded Successfully",
                        icon: "success",
                        button: "Ok!"
                    });
                }
                else if (response.STATUS == 2) {
                    //$('#name').val("");
                    //$('#desg').val("");
                    //$('#mob').val("");
                    //$('#mail').val("");
                    //$('#addr').val("");
                    swal({
                        text: "Can not connect HRIS",
                        icon: "warning",
                        button: "Ok!"
                    }).then(okay => {
                        if (okay) {
                            window.location.reload();
                        }
                    });
                }
                else if (response.STATUS == 3) {
                    //$('#name').val("");
                    //$('#desg').val("");
                    //$('#mob').val("");
                    //$('#mail').val("");
                    //$('#addr').val("");
                    swal({
                        text: "User not found in HRIS",
                        icon: "error",
                        button: "Ok!"
                    }).then(okay => {
                        if (okay) {
                            window.location.reload();
                        }
                    });
                }

            })
        };
    }
</script>
}

@model PM.ModelsV.StaffHealthCard

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.OWNR_ID)

    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Staff Health Card</span>
            @Html.EditorFor(model => model.OWNR_HEALTH_CARD, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            @Html.ValidationMessageFor(model => model.OWNR_HEALTH_CARD, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Health Card Expire Date</span>
            @Html.EditorFor(model => model.OWNR_HEALTH_CARD_EDATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "dd/MM/yyyy" } })
            @Html.ValidationMessageFor(model => model.OWNR_HEALTH_CARD_EDATE, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
        </div>
    </div>

}

@model IEnumerable<PM.ModelsV.StaffVM>

@{
    ViewBag.Title = "Staff";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Staff", "AssetUser", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("StaffId", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Staff Id / Name", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
                <!-- /btn-group -->
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewStaff", "AssetUser")" class="btn btn-primary"> New Staff</a>
            <a href="@Url.Action("Staff","AssetUser")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>


<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_TEXT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_USER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_NDATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_DESG)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_CONT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_EMAIL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_ADDR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_TYPE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_STYPE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OWNR_POST)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AREA_V)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DEPARTMENT_V)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BUSINESS_V)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_V)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>
                    <div class="input-group-btn">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                            Action
                            <span class="fa fa-caret-down"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <input type="submit" class="FileUp form-control btn btn-flat btn-primary" value="Edit" data-url="@Url.Action("StaffEdit","AssetUser", new { id= item.OWNR_ID})" />
                            </li>
                        </ul>
                    </div>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_TEXT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_USER)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_NDATE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_DESG)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_CONT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_EMAIL)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_ADDR)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_NOTE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_TYPE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OWNR_STYPE)
                </td>
                <td>
                    @if (item.OWNR_POST == true)
                    {
                        <span class="label label-danger">Use a Asset</span>
                    }
                    else
                    {
                        <span class="label label-success">Not Used</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AREA_V)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DEPARTMENT_V)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BUSINESS_V)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.COMPANY_V)
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    <script src="~/Scripts/AssetUser/EditStaff.js"></script>
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}
@model PM.ModelsV.CarEdit

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ASET_ID)

    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Asset Name</span>
            @Html.EditorFor(model => model.ASET_CODE_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", @Readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.ASET_CODE_NAME, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Business Unit</span>
            @Html.DropDownList("ASET_BUSINESS", null, "--Select New One--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", onchange = "FindDepts();" })
            @Html.ValidationMessage("ASET_BUSINESS", "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Department</span>
            @Html.DropDownListFor(model => model.ASET_DEPARTMENT, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", name = "ASET_DEPARTMENT", id = "ASET_DEPARTMENT" })
            @Html.ValidationMessageFor(model => model.ASET_DEPARTMENT, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Area</span>
            @Html.DropDownListFor(model => model.ASET_AREA, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
            @Html.ValidationMessageFor(model => model.ASET_AREA, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Note</span>
            @Html.EditorFor(model => model.ASET_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note(s)" } })
            @Html.ValidationMessageFor(model => model.ASET_NOTE, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10 input-group">
            <span class="input-group-addon">Height</span>
            @Html.EditorFor(model => model.ASET_HEIGHT, new { htmlAttributes = new { @class = "form-control", placeholder = "Height" } })
            @Html.ValidationMessageFor(model => model.ASET_HEIGHT, "", new { @class = "text-danger" })
        </div>
    </div>
    <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
}
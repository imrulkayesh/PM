
@{
    ViewBag.Title = "AUDIT DASHBOARD";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f8f9fa;
        padding: 20px;
    }

    h1 {
        text-align: center;
        color: #333;
        margin-bottom: 20px;
        font-size: 18px;
        line-height: 0.1;
    }

    h5 {
        color: white !important;
        line-height: 0.3;
        font-size: 15px;
        text-align: center;
    }

    .dashboard {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .card {
        background: #fff;
        border-radius: 40px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .card-header {
        background: #2f75b5;
        color: white;
        padding: 8px;
        font-weight: bold;
        text-align: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 6px;
        text-align: center;
        border: 1px solid #ddd;
    }

    th {
        background: #2f75b5;
        color: white;
    }

    .highlight {
        background: #ffeb3b;
        font-weight: bold;
    }
</style>

<div class="panel panel-success">
    @*<div class="panel-heading">
            *if the value is different from reports, you will take reports data are right.
        </div>*@
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                Select Year :
            </div>
            <div class="col-md-4">
                <form method="get">
                    <select name="year" onchange="this.form.submit()" class="form-control">
                        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 2; y--)
                        {
                            <option value="@y" @(ViewBag.SelectedYear == y ? "selected" : "")>
                                @y
                            </option>
                        }
                    </select>
                </form>
            </div>
            <div class="col-md-4">
            </div>
        </div>
        <br />

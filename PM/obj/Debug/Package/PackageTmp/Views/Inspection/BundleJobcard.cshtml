@model IEnumerable<PM.ModelsV.BundleInspectionApp>

@{
    ViewBag.Title = "Bundle Job Card";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<p class="text-red fa fa-warning"> Bundle Job Card are submitted automatically with current date. You can't edit or update after creating bundle Job Card. No addition or deduction amounts are allowed</p>
<table class="table">
    <tr>
        <th>
            #
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BUNDLE_ID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TOTAL_ASET)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AMOUNT)
        </th>
        <th>
            Vendor
        </th>
        <th>
            Note
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <input type="submit" class="btn4 btn btn-flat btn-primary" value="View" data-url="@Url.Action("BundleInspectionAppView", "Inspection", new { id = item.BUNDLE_ID })" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BUNDLE_ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TOTAL_ASET)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AMOUNT)
            </td>

            @using (Html.BeginForm("BundleJobcard", "Inspection", new { id = item.BUNDLE_ID }, FormMethod.Post))
            {
                <td>
                    @Html.Hidden("BUNDLE_ID", value:item.BUNDLE_ID)
                    @Html.Editor("VENDOR_NAME", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Vendor Name" } })
                </td>
                <td>
                    @Html.Editor("VENDOR_NOTE", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Recommendation" } })
                </td>
                <td>
                    <input type="submit" value="Create Job" class="btn btn-flat btn-danger" />
                </td>
            }



        </tr>
    }
</table>
<hr />
<div id="VDI" class="table-responsive"></div>
@section scripts{
    <script>
        $(document).ready(function () {
            $('.btn4').click(function () {
                var url = $(this).data('url');
                $.get(url, function (data) {
                    $('#VDI').html(data);
                });
            });
        });
    </script>

}
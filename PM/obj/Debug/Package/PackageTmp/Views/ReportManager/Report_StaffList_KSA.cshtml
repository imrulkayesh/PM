@{
    ViewBag.Title = "Report_StaffList_KSA";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div class="col-md-12">
    <div class="box box-warning box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">Staff List [KSA]</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            @using (Html.BeginForm("Report_StaffList_KSA", "ReportManager"))
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Area</span>
                            @Html.DropDownList("AREA_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("AREA_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Business</span>
                            @Html.DropDownList("BUSINESS_ID", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("BUSINESS_ID", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Is use a Asset</span>
                            @Html.DropDownList("ASET_USED", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("ASET_USED", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Status</span>
                            @Html.DropDownList("ASET_CLOSED", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("ASET_CLOSED", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Iquama Expire</span>
                            @Html.DropDownList("REMIND", null, "--Select All--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            @Html.ValidationMessage("REMIND", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <button type="submit" class="btn bg-olive btn-flat margin">Submit</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>
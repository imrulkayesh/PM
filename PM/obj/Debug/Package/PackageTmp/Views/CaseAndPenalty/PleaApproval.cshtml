@model IEnumerable<PM.ModelsV.CasePenlatyView>

@{
    ViewBag.Title = "Traffic Penalty Approval";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_DFND)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_PAID_BY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_REF)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_REASON)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_DESC)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_AMNT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_LOCATION)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_OWNR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_MILEAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_ASET)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_DEPT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_AREA)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PLEA_STATUS)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @using (Html.BeginForm("PleaApproval", "CaseAndPenalty", new { id = item.PLEA_ID }))
                        {
                            <input type="submit" class="btn btn-danger btn-flat" value="Approve" />
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_DFND)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_PAID_BY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_REF)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_REASON)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_DESC)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_AMNT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_LOCATION)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_OWNR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_MILEAGE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_ASET)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_DEPT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_AREA)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PLEA_STATUS)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
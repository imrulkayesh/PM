@model IEnumerable<PM.ModelsV.LicenseDocumnetVM>
@{
    ViewBag.Title = "License Document";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="btn-group margin">
            <a href="@Url.Action("NewLicenseDocument", "License")" class="btn btn-primary"> New License Document</a>
            <a href="@Url.Action("Index","License")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_NAME_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DOCUMENT_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DAYS)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMARKS)
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DOCUMENT_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DAYS)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMARKS)
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>


@model PM.ModelsV.ClaimReceive

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.CLAIM_ID)

    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Amount</span>
                @Html.EditorFor(model => model.CLAIM_AMOUNT, new { htmlAttributes = new { @class = "form-control", placeholder = "Claim Amount", autofocus = true, required = "required", @Readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.CLAIM_AMOUNT, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Receive Amount</span>
                @Html.EditorFor(model => model.RECEIVE_AMOUNT, new { htmlAttributes = new { @class = "form-control", placeholder = "Claim Receive Amount", autofocus = true, required = "required" } })
                @Html.ValidationMessageFor(model => model.RECEIVE_AMOUNT, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Receive Date</span>
                @Html.EditorFor(model => model.RECEIVE_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "MM/dd/yyyy" } })
                @Html.ValidationMessageFor(model => model.RECEIVE_DATE, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Claim Status</span>
                @Html.DropDownListFor(model => model.CLAIM_STATUS_LIST, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.CLAIM_STATUS_LIST, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Remark</span>
                @Html.EditorFor(model => model.RECEIVEREMARK, new { htmlAttributes = new { @class = "form-control", placeholder = "Remark", autofocus = true } })
                @Html.ValidationMessageFor(model => model.RECEIVEREMARK, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
        </div>
    </div>

}




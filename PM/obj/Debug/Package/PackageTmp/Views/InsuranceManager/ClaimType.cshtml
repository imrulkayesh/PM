        @using (Html.BeginForm("ClaimType", "InsuranceManager", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("Insurance", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Claim Type Name", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">

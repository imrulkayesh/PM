@model PM.ModelsV.OutletVM

@{
    ViewBag.Title = "New Outlet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                @ViewBag.Title
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">
                @using (Html.BeginForm("NewOutlet", "AssetUser", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Outlet Id</span>
                                @Html.EditorFor(model => model.OWNR_TEXT, new { htmlAttributes = new { @class = "form-control", placeholder = "Outlet Id [Auto]", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.OWNR_TEXT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Outlet Name</span>
                                @Html.EditorFor(model => model.OWNR_USER, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Outlet Name", autofocus = true } })
                                @Html.ValidationMessageFor(model => model.OWNR_USER, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Proprietor</span>
                                @Html.EditorFor(model => model.OWNR_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Outlet Owner" } })
                                @Html.ValidationMessageFor(model => model.OWNR_NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Proprietor NID</span>
                                @Html.EditorFor(model => model.OWNR_DESG, new { htmlAttributes = new { @class = "form-control", placeholder = "Proprietor NID" } })
                                @Html.ValidationMessageFor(model => model.OWNR_DESG, "", new { @class = "text-danger" })
                            </div>
                        </div>



                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Mobile</span>
                                @Html.EditorFor(model => model.OWNR_CONT, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Mobile No" } })
                                @Html.ValidationMessageFor(model => model.OWNR_CONT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Email</span>
                                @Html.EditorFor(model => model.OWNR_EMAIL, new { htmlAttributes = new { @class = "form-control", placeholder = "Email" } })
                                @Html.ValidationMessageFor(model => model.OWNR_EMAIL, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal col-md-6">

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Address</span>
                                @Html.EditorFor(model => model.OWNR_ADDR, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Address" } })
                                @Html.ValidationMessageFor(model => model.OWNR_ADDR, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Note</span>
                                @Html.EditorFor(model => model.OWNR_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note" } })
                                @Html.ValidationMessageFor(model => model.OWNR_NOTE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Area</span>
                                @Html.DropDownListFor(model => model.OWNR_AREA, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.OWNR_AREA, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Business</span>
                                @Html.DropDownList("OWNR_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "getDeptList();" })
                                @Html.ValidationMessage("OWNR_BUSINESS", "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Dept</span>
                                @Html.DropDownListFor(model => model.OWNR_DEPT, Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.OWNR_DEPT, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                                <a href="@Url.Action("Outlet","AssetUser")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>


                }
            </div>
            <div class="panel-footer">
                New Outlet Entry
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script src="~/Scripts/AssetUser/NewOutlet.js"></script>
}
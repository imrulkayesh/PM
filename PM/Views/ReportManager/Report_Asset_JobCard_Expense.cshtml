@section scripts{
    <script>
        //Add Multiple Order.
        $("#ITEM_IDx").change(function (e) {
            e.preventDefault();
            var FD = $('#F_BILH_DATEx');
            var TD = $('#T_BILH_DATEx');
            if (FD == "" || TD == "") {
                swal('Ohh..', 'Select a valid date', 'warning');
                return;
            }
            var ITEM_ID = $.trim($("#ITEM_IDx :selected").val()),
                        ITEM_NAME = $("#ITEM_IDx :selected").text()
            if (ITEM_ID == "") {
                swal('Ohh..', 'Select a valid item', 'warning');
                return;
            };
            var rowCount = $('#ItemList tr').length;
            var ItemList = $("#ItemList tbody");
            var ItemListX = '<tr><td name="' + rowCount + '">' + ITEM_ID + '</td><td>' + ITEM_NAME + '</td><td><a data-itemId="0" href="#" class="deleteItem btn btn-danger btn-sm"><i class="fa fa-trash" /></a></td></tr>';
            ItemList.append(ItemListX);
            clearItem();
        });
        //After Add A New Order In The List, Clear Clean The Form For Add More Order.
        function clearItem() {
            $('#ITEM_IDx :selected').remove();
        }

        //Clear List if user want
        $(document).on('click', 'a.deleteItem', function (e) {
            e.preventDefault();
            var $self = $(this);
            if ($(this).attr('data-itemId') == "0") {
                $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                    $(this).remove();
                });
            }
        });

        //Save
        function saveJobCard(data) {
            //return $.ajax({
            //    contentType: 'application/json; charset=utf-8',
            //    dataType: 'blob',
            //    type: 'POST',
            //    url: "Item_Wise_Report",
            //    data: data,
            //    success: function (response) {
            //        //if (response.success) {
            //        //    swal('Success..', response.messag, 'success');
            //        //} else {
            //        //    swal('Opps..', response.messag, 'warning');
            //        //}
            //    },
            //    error: function () {
            //        //swal('Opps..', 'an error occured', 'error');
            //    }
            //});

      //   Use XMLHttpRequest instead of Jquery $ajax
            xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                debugger;
                var a;
                if (xhttp.readyState === 4 && xhttp.status === 200) {
                    // Trick for making downloadable link
                    a = document.createElement('a');
                    a.href = window.URL.createObjectURL(xhttp.response);
                    // Give filename you wish to download
                    a.download = "Item_wise_expense_report.xlsx";
                    a.style.display = 'none';
                    document.body.appendChild(a);
                    a.click();
                }
            };
            // Post data to URL which handles post request
            xhttp.open("POST", 'Item_Wise_Report');
            xhttp.setRequestHeader("Content-Type", "application/json");
            // You should set responseType as blob for binary responses
            xhttp.responseType = 'blob';
            // xhttp.send(JSON.stringify(data));
            xhttp.send(data);
       
        };


        //Collect Multiple Order List For Pass To Controller
        $("#VItemR").click(function (e) {
            e.preventDefault();
            var ItemArr = [];
            ItemArr.length = 0;
            var Skp = "";
            $.each($("#ItemList tbody tr"), function () {
                var JI = $.trim($(this).find('td:eq(0)').html());
                if (JI == "") {
                    Skp = JI;
                }
                ItemArr.push({
                    JOB_ITEM: JI
                });
            });
            if (Skp !== "") {
                swal('Opps..', Skp + ' :Item data is not completed', 'info');
                return;
            }
            var F_BILH_DATEx = $("#F_BILH_DATEx").val(),
                T_BILH_DATEx = $("#T_BILH_DATEx").val();

            if (F_BILH_DATEx == "" || T_BILH_DATEx == "") {
                swal('Ohh..', 'Select a valid date', 'warning');
                return;
            };
            if (ItemArr.length <= 0) {
                swal('Ohh..', 'Select at least one item', 'warning');
                return;
            }

            var data = JSON.stringify({
                F_BILH_DATEx, T_BILH_DATEx, ITEM_IDx: ItemArr
            });

            $.when(saveJobCard(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });
        });

    </script>
}
@model PM.ModelsV.ExcelInputVM
@{
    ViewBag.Title = "New Fridge Excel";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div id="overlay" class="hide">
    <div class="loader">
    </div>
</div>


@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.MyExcelFile, new { type = "file", required = "required" })
                            <p class="help-block">.xlsx file format only and maximum 50 rows in Excel file</p>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">Load Excel File</button>
                            <a href="@Url.Action("Index","AssetManager")" class="btn btn-primary">Back</a>
                        </div>
                        <div class="col-md-4">
                            <span style="color:red">
                                <strong>
                                    @Html.ValidationMessageFor(x => x.MyExcelFile)
                                </strong>
                            </span>
                        </div>
                    </div>
                </div>
                <form id="NewUploadForm">
                    <div class="panel-body">
                        <div class="table-responsive">
                            @Html.Raw(Model.MSExcelTable)
                        </div>
                        <div class="table-responsive">

                        </div>
                    </div>
                    <div class="panel-footer">
                        <button id="saveDatabase" type="submit" class="btn btn-primary">Check &amp; Upload</button>
                    </div>
                </form>
            </div>
            <div class="panel box box-danger">
                <div class="box-header with-border">
                    <h4 class="box-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" style="color:blue">
                            Excel Format
                        </a>
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse">
                    <div class="box-body">
                        <h4 style="color:red">NewFridgeExcel.xlsx</h4>
                        <table class="table" border="1">
                            <thead>
                                <tr>
                                    <th>FRIDGE_NO</th>
                                    <th>DEPARTMENT</th>
                                    <th>AREA</th>
                                    <th>BRAND</th>
                                    <th>GROUP</th>
                                    <th>MODEL</th>
                                    <th>PO_NO</th>
                                    <th>GRN_NO</th>
                                    <th>CAPACITY</th>
                                    <th>PRICE</th>
                                    <th>REG_DATE</th>
                                    <th>YEAR</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>VCF01-01-0001</td>
                                    <td>DT0002</td>
                                    <td>RSB26041</td>
                                    <td>BR0001</td>
                                    <td>GR0003</td>
                                    <td>SA</td>
                                    <td>123456</td>
                                    <td>654321</td>
                                    <td>20 Ltr</td>
                                    <td>15000</td>
                                    <td>01-04-2020</td>
                                    <td>2020</td>
                                    <td>Demo</td>
                                </tr>
                                <tr>
                                    <td>VCF01-01-0002</td>
                                    <td>DT0002</td>
                                    <td>RSB26041</td>
                                    <td>BR0001</td>
                                    <td>GR0003</td>
                                    <td>SA</td>
                                    <td>123456</td>
                                    <td>654321</td>
                                    <td>20 Ltr</td>
                                    <td>15000</td>
                                    <td>01-04-2020</td>
                                    <td>2020</td>
                                    <td>Demo</td>
                                    
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.col-lg-4 -->
    </div>
}
@section scripts{
    <script src="~/Scripts/AssetManager/FridgeExcel.js"></script>
}
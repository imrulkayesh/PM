@model PM.Model.A_ASET_APP

@{
    ViewBag.Title = "Bike Close";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        @using (Html.BeginForm(FormMethod.Post))
        {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-3">
                <div class="form-group input-group">
                    <span class="input-group-addon">Asset</span>
                    @Html.EditorFor(model => model.ASET_ID, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Enter full name" } })
                    @Html.ValidationMessageFor(model => model.ASET_ID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group input-group">
                    <span class="input-group-addon">Apply For</span>
                    @Html.DropDownList("APPLY_TYPE", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                    @Html.ValidationMessageFor(model => model.APPLY_TYPE, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group input-group">
                    <span class="input-group-addon">Apply Date</span>
                    @Html.EditorFor(model => model.APPLY_DATE, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "dd/MM/yyyy", type = "date" } })
                    @Html.ValidationMessageFor(model => model.APPLY_DATE, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group input-group">
                    <span class="input-group-addon">Asset Value</span>
                    @Html.EditorFor(model => model.ASET_VALUE, new { htmlAttributes = new { @class = "form-control", type = "number", Value="0" } })
                    @Html.ValidationMessageFor(model => model.ASET_VALUE, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-9">
                <div class="form-group input-group">
                    <span class="input-group-addon">Reason</span>
                    @Html.EditorFor(model => model.APPLY_REASON, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Application Reason", type = "text" } })
                    @Html.ValidationMessageFor(model => model.APPLY_REASON, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <input type="text" disabled="disabled" id="AsetLoc" class="form-control" placeholder="Base Information" />
            </div>
            <div class="col-md-6 form-group">
                <input type="text" disabled="disabled" id="WorkLoc" class="form-control" placeholder="Working Information" />
            </div>
        </div>
        <div class="row">
            <div class="btn-group col-md-12">
                <a href="@Url.Action("BlikeClosing","AssetManager")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                <a href="@Url.Action("BlikeClosing","AssetManager")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Submit</button>
            </div>
        </div>
        }
    </div>
    <div class="panel-footer">
        New Close Entry
    </div>
</div>


<div class="panel panel-primary">
    <div class="panel-heading">
        Bike Close Report
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Report_Closed_Bike", "ReportManager", FormMethod.Post))
        {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="btn-group col-md-12">
                <button type="submit" id="CreateJob" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Submit</button>
            </div>
        </div>
        }
    </div>
    <div class="panel-footer">
        Bike Close Report
    </div>
</div>


@section scripts{
    @Scripts.Render("~/bundles/jqueryval")

<script>
    $(document).ready(function () {
        $('#ASET_ID').blur(function () {
            var url = 'BlikeClosing_Data';
            var ASET_ID = $('#ASET_ID').val();
            if (ASET_ID == '') {
                return;
            }
            $.getJSON(url, { id: ASET_ID }, function (response) {
                $('#AsetLoc').val(response.prim);
                $('#WorkLoc').val(response.seco);
            });
        });
    })
</script>
}

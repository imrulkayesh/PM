@using (Html.BeginForm("ReturnAsset", "AssetUserManager", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <p style="color:red"><strong>Please upload required documents before proceeding.</strong></p>
    <input type="hidden" id="AU_ID" name="AU_ID" value="@ViewBag.TrnsId" />
    <div class="margin form-horizontal">
        <div class="form-group input-group">
            <span class="input-group-addon">Date</span>
            <input type="date" id="AU_ERDATE" name="AU_ERDATE" class="form-control" placeholder="dd/mm/yyyy" required="required" />
        </div>
        <div class="form-group input-group">
            <span class="input-group-addon">Mileage</span>
            <input type="number" id="AU_EMAILAGE" name="AU_EMAILAGE" class="form-control" placeholder="Mileage" required="required" />
        </div>
        <div class="form-group input-group">
            <span class="input-group-addon">Note</span>
            <input type="text" id="AU_ENOTE" name="AU_ENOTE" class="form-control" placeholder="Reason" required="required" maxlength="50" />
        </div>
        <div class="form-group">
            <input type="submit" value="Request to Return" class="btn btn-danger" />
        </div>
    </div>
}
@model IEnumerable<PM.Model.A_ASET_USER_IMG>

    <table class="table">
        <tr>
            <th>
                Attachment(s)
            </th>
            <th>
                Action
            </th>
        </tr>

        @foreach (var item in Model)
        {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IMG_NAME)
            </td>
            <td>
                @Html.ActionLink("Download", "Download", new { id= item.IMG_ID })
            </td>
        </tr>
        }

    </table>

@model IEnumerable<PM.ModelsV.JobCardView>

@{
    ViewBag.Title = "Job Card";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}


<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("JobCard", "Inspection", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("JobCard", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Job Card Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
                <!-- /btn-group -->
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewJobCard", "Inspection")" class="btn btn-success"> New Job Card</a>
            <a href="@Url.Action("BundleJobcard", "Inspection")" class="btn btn-primary"> Bundle Job Card</a>
            <a href="@Url.Action("JobCard","Inspection")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_ASET)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_OWNR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_DEPARTMENT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_AREA)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_MILEAGE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_TYPE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_VENDOR)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_IPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_UPAY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JOBH_CPAY)
                </th>
                <th>Total</th>
                <th>#</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_ASET)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_OWNR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_DEPARTMENT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_AREA)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_MILEAGE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_TYPE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_VENDOR)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_NOTE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_IPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_UPAY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JOBH_CPAY)
                    </td>
                    <td>
                        @{
                            var x = item.JOBH_IPAY + item.JOBH_UPAY + item.JOBH_CPAY;
                        }
                        @x
                    </td>
                    <td>
                        <div class="input-group-btn">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                Action
                                <span class="fa fa-caret-down"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <input type="submit" class="btn4 btn btn-flat btn-primary" value="View" data-url="@Url.Action("ViewJobCard", "Inspection", new { id = item.JOBH_ID })" />
                                </li>
                                <li>
                                    <input type="submit" class="FileUp btn btn-flat btn-primary" value="Attach File" data-url="@Url.Action("AttachFile", "Inspection", new { id = item.JOBH_ID })" />

                                </li>
                                <li>
                                    <a href="@Url.Action("DownloadAttachFile", "Inspection", new { id = item.JOBH_ID })" , class="btn btn-flat btn-primary">Download File</a>
                                </li>
                                <li>
                                    @Html.ActionLink("Edit", "EditJobCard", new { id = item.JOBH_ID })
                                </li>

                                @using (Html.BeginForm("SubmiJob", "Inspection", new { id = item.JOBH_ID }))
                                {
                                    <li>
                                        <input type="submit" class="btn btn-success btn-flat" value="Submit" />
                                    </li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
                            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="pvModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

@section scripts{
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}
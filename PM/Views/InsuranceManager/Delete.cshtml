@model PM.ModelsV.DeleteVM

@using (Html.BeginForm(FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.INSURANCE_MST_ID)

    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance Number</span>
                @Html.EditorFor(model => model.INSURANCE_NUMBER, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", @Readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INSURANCE_NUMBER, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Delete</button>
        </div>
    </div>

            }


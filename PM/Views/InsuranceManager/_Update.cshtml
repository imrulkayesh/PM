@model PM.ModelsV.InsuranceUpdateVM

@using (Html.BeginForm("Update", "InsuranceManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.INSURANCE_MST_ID)

    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Company Name</span>
                @Html.DropDownListFor(model => model.COMPANY_ID, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.COMPANY_ID, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Beneficiary Details</span>
                @Html.EditorFor(model => model.BENIFICIARY_DETAILS, new { htmlAttributes = new { @class = "form-control", placeholder = "License Number", autofocus = true } })
                @Html.ValidationMessageFor(model => model.BENIFICIARY_DETAILS, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
   <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Types of Insurance/Risk</span>
                @Html.DropDownListFor(model => model.INSURANCE_TYPE_ID, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.INSURANCE_TYPE_ID, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance Company</span>
                @Html.DropDownListFor(model => model.INSURANCE_COMPANY_ID, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                @Html.ValidationMessageFor(model => model.INSURANCE_COMPANY_ID, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Insured Item</span>
                @Html.EditorFor(model => model.INSURED_ITEM, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.INSURED_ITEM, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Occupation</span>
                @Html.EditorFor(model => model.OCCUPATION, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.OCCUPATION, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Date of Issue</span>
                @Html.EditorFor(model => model.INSURANE_DATE, new { htmlAttributes = new { @class = "form-control", placeholder = "dd/MM/yyyy" } })
                @Html.ValidationMessageFor(model => model.INSURANE_DATE, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Date of Issue</span>
                @Html.EditorFor(model => model.INSURANCE_EXPAIR_DATE, new { htmlAttributes = new { @class = "form-control", placeholder = "dd/MM/yyyy" } })
                @Html.ValidationMessageFor(model => model.INSURANCE_EXPAIR_DATE, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance (Policy) Number</span>
                @Html.EditorFor(model => model.INSURANCE_NUMBER, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.INSURANCE_NUMBER, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-9">
            <div class="form-group input-group">
                <span class="input-group-addon">Insurance Amount</span>
                @Html.EditorFor(model => model.INSURANCE_AMOUNT, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.INSURANCE_AMOUNT, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Net Premium Amount</span>
                @Html.EditorFor(model => model.NET_PREMIUM, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.NET_PREMIUM, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">VAT</span>
                @Html.EditorFor(model => model.VAT, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.VAT, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">STAMP</span>
                @Html.EditorFor(model => model.STAMP, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.STAMP, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group input-group">
                <span class="input-group-addon">Requested By</span>
                @Html.EditorFor(model => model.REQUEST_BY, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.REQUEST_BY, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group input-group">
                <span class="input-group-addon">Description</span>
                @Html.EditorFor(model => model.DESCRIPTION, new { htmlAttributes = new { @class = "form-control", autofocus = true } })
                @Html.ValidationMessageFor(model => model.DESCRIPTION, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="form-group input-group">
                <span class="input-group-addon">Attachment</span>
                <input type="file" name="FileX" id="FileX" class="form-control" accept="image/jpeg, image/png">
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-save"></i> Save</button>
        </div>
    </div>

}





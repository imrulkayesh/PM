@model PM.ModelsV.LicenseVM
@{
    ViewBag.Title = "New License Name";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="panel panel-primary">
    <div class="panel-heading">
        @ViewBag.Title
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
    <div class="panel-body">

        @using (Html.BeginForm("NewLicense", "LicenseName", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">License Type</span>
                    @Html.DropDownListFor(model => model.LICENSE_TYPE_ID, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                    @Html.ValidationMessageFor(model => model.LICENSE_TYPE_ID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">License Name</span>
                    @Html.EditorFor(model => model.LICENSE_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "License Name" } })
                    @Html.ValidationMessageFor(model => model.LICENSE_NAME, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">Application Days</span>
                    @Html.EditorFor(model => model.APPLICATION_DAYS, new { htmlAttributes = new { @class = "form-control", placeholder = "Application Days", autofocus = true, onchange = "CopyToCode();" } })
                    @Html.ValidationMessageFor(model => model.APPLICATION_DAYS, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group input-group">
                    <span class="input-group-addon">Application Notify Days</span>
                    @Html.EditorFor(model => model.NOTIFY_DAYS, new { htmlAttributes = new { @class = "form-control", placeholder = "Application Notify Days", autofocus = true, onchange = "CopyToCode();" } })
                    @Html.ValidationMessageFor(model => model.NOTIFY_DAYS, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group input-group">
                    <span class="input-group-addon">Remark</span>
                    @Html.EditorFor(model => model.REMARKS, new { htmlAttributes = new { @class = "form-control", placeholder = "" } })
                    @Html.ValidationMessageFor(model => model.REMARKS, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                <div class="btn-group">
                    <a href="@Url.Action("Index","LicenseName")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                    <a href="@Url.Action("NewLicense","LicenseName")" class="btn btn-warning"><i class="fa fa-close"></i> Cancel</a>
                </div>
            </div>
        </div>
        }
    </div>
    <div class="panel-footer">
        New License Nmae Entry
    </div>
</div>


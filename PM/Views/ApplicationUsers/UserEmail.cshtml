@model PM.ModelsV.UserEmailList
@{
    ViewBag.Title = "User Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-success box-solid">
            <div class="box-header with-border">
                <h3 class="box-title">@ViewBag.Title</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-minus"></i>
                    </button>
                </div>
                <!-- /.box-tools -->
            </div>
            <!-- /.box-header -->
            <div class="box-body">
                @using (Html.BeginForm())
            {
                    <div class="row">
                        <div class="form-group col-md-3">
                            @Html.Editor("EMAIL_ID", new { htmlAttributes = new { @class = "form-control", placeholder = "SMTP", required = "required" } })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Editor("EMAIL_DISPLAY", new { htmlAttributes = new { @class = "form-control", placeholder = "Email Display", required = "required" } })
                        </div>
                        <div class="form-group col-md-2">
                            @Html.DropDownList("KEEP_IN", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                        <div class="form-group col-md-2">
                            @Html.DropDownList("MAIL_TYPE", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                        <div class="form-group col-md-2">
                            @Html.DropDownList("MAIL_GROUP", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-2">
                            @Html.DropDownList("MAIL_BUSINESS", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        </div>
                        <div class="form-group col-md-2">
                            @Html.DropDownList("AREA_ID", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                        </div>
                        <div class="form-group col-md-2">
                            @Html.CheckBox("ACT_B", new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        </div>
                        <div class="form-group col-md-2">
                            <input type="submit" value="Find" name="Find" class="btn btn-primary" />
                            <input type="submit" value="Submit" name="Submit" class="btn btn-danger" />
                        </div>
                        <div class="form-group col-md-2">
                            <a href="@Url.Action("UserEmail","ApplicationUsers")" class="form-control btn btn-warning">Clear</a>
                        </div>
                    </div>
                }
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>
<div class="col-md-10">
    <div class="box box-primary box-solid">
        <div class="box-header with-border">
            <h3 class="box-title">User Mail</h3>
            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <!-- /.box-tools -->
        </div>
        <!-- /.box-header -->
        <div class="box-body table-responsive">

            @if (Model != null)
            {
                if (Model.User_Email_List != null && Model.User_Email_List.Count > 0)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Display Name</th>
                                <th>Keep In</th>
                                <th>Mail Type</th>
                                <th>Mail Group</th>
                                <th>Business</th>
                                <th>Area</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.User_Email_List.OrderBy(x=>x.MAIL_TYPE))
                            {
                                <tr>
                                    <td>@item.EMAIL_ID</td>
                                    <td>@item.EMAIL_DISPLAY</td>
                                    <td>@item.KEEP_IN</td>
                                    <td>@item.MAIL_TYPE</td>
                                    <td>@item.MAIL_GROUP</td>
                                    <td>@item.MAIL_BUSINESS</td>
                                    <td>@item.AREA_ID</td>
                                    <td>@item.ACT</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                <p>No Record</p>
            }
        </div>
        <!-- /.box-body -->
    </div>
    <!-- /.box -->
</div>
@model IEnumerable<PM.Models.ASGRVM>

@{
    ViewBag.Title = "UserGroupList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">

        <div class="box">
            <div class="box-header">
                <h3 class="box-title">User Item Group List</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="generalDT" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>
                                Group Name
                            </th>
                            <th>
                                User
                            </th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASGR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.USER_TEXT)
                                </td>
                                <td>
                                    @if (item.USER_TEXT == null)
                                    {
                                        <a href="@Url.Action("AddNewGroup","Users", new { asgrId = item.ASGR_TEXT,staffId=HttpContext.Current.Request.RequestContext.RouteData.Values["id"] , ReturnUrl = Request.Url.AbsoluteUri })" class="fa fa-check-circle"> Add</a>
                                    }
                                    else
                                    {
                                        if (item.UAP_ACTV == true)
                                        {
                                            <a href="@Url.Action("AddRemoveGroup","Users", new { asgrId = item.ASGR_USER, YN = false , ReturnUrl = Request.Url.AbsoluteUri })" class="fa fa-remove"> Del</a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("AddRemoveGroup","Users", new { asgrId = item.ASGR_USER, YN = true, ReturnUrl = Request.Url.AbsoluteUri })" class="fa fa-check-circle"> Add</a>
                                        }

                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>
                                Group Name
                            </th>
                            <th>
                                User
                            </th>
                            <th>#</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>
@model PM.Models.ChildMenuVM

@{
    ViewBag.Title = "NewChildMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("NewChildMenu", "Menu"))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal col-md-6">
        <h4>New Child Menu</h4>
        <a href="@Url.Action("ParentMenu", "Menu")">Back to List</a>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_ID, "Id", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_ID, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "Enter Id", onchange = "copyIdtoText();" } })
                @Html.ValidationMessageFor(model => model.MENUC_ID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_MENUP_ID, "Parent", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.MENUC_MENUP_ID, null, htmlAttributes: new { @class = "form-control", required = "Required" } )
                @Html.ValidationMessageFor(model => model.MENUC_MENUP_ID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_TEXT, "Code", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_TEXT, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "Enter Code", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.MENUC_TEXT, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_NAME, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_NAME, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "Enter Name" } })
                @Html.ValidationMessageFor(model => model.MENUC_NAME, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_ICON, "Icon", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_ICON, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "font awsome icon" } })
                @Html.ValidationMessageFor(model => model.MENUC_ICON, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_CONTROLLER, "Controller Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_CONTROLLER, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "Controller Name" } })
                @Html.ValidationMessageFor(model => model.MENUC_CONTROLLER, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_ACTION, "Action Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MENUC_ACTION, new { htmlAttributes = new { @class = "form-control", required = "Required", placeholder = "Enter Action Name" } })
                @Html.ValidationMessageFor(model => model.MENUC_ACTION, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.MENUC_ACTV, "Status", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.MENUC_ACTV, new { htmlAttributes = new { @class = "form-control", required = "Required" } })
                    @Html.ValidationMessageFor(model => model.MENUC_ACTV, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<script>
    function copyIdtoText() {
        document.getElementById('MENUC_TEXT').value = document.getElementById('MENUC_ID').value;
    }
</script>
@model IEnumerable<PM.Models.MENUC>

@{
    ViewBag.Title = "ChildMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="snackbar">@TempData["MSG"]</div>
@if (TempData["MSG"] != null)
{
    <script>
        var x = document.getElementById("snackbar");
        x.className = "show";
        setTimeout(function () { x.className = x.className.replace("show", ""); }, 3000);
    </script>
}
<p>
    <!-- /.col-lg-4 -->
    <div class="col-lg-10">
        <div class="panel panel-info">
            <div class="panel-heading">
                <a href="@Url.Action("NewChildMenu","Menu")" class="btn btn-sm btn-primary">New</a>
                <a href="@Url.Action("Index","Menu")" class="btn btn-sm btn-default">Back</a>
            </div>
            <div class="panel-body">
                <table class="table table-responsive table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>
                                Menu Id
                            </th>
                            <th>
                                Parent
                            </th>
                            <th>
                                Menu Code
                            </th>
                            <th>
                                Menu Name
                            </th>
                            <th>
                                Controller
                            </th>
                            <th>
                                Action
                            </th>
                            <th>
                                Icon
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </thead>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(m => item.MENUC_ID)</td>
                            <td>@Html.DisplayFor(m => item.MENUC_MENUP_ID)</td>
                            <td>@Html.DisplayFor(m => item.MENUC_TEXT)</td>
                            <td>@Html.DisplayFor(m => item.MENUC_NAME)</td>
                            <td>@Html.DisplayFor(m => item.MENUC_CONTROLLER)</td>
                            <td>@Html.DisplayFor(m => item.MENUC_ACTION)</td>
                            <td class="@Html.DisplayFor(m => item.MENUC_ICON)"></td>
                            <td>@Html.DisplayFor(m => item.MENUC_ACTV)</td>
                        </tr>
                    }
                </table>
            </div>
            <div class="panel-footer">
                Child Menu List
            </div>
        </div>
    </div>
    <!-- /.col-lg-4 -->

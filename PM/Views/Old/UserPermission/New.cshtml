@model PM.Models.MakeUserVM

@{
    ViewBag.Title = "New";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("New", "UserPermission"))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal col-md-6">
        <h4>New User</h4>
        <a href="@Url.Action("Index","UserPermission")" class="btn btn-sm btn-info">Back</a>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.USER_TEXT, "User Id", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_TEXT, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "User Id", onchange = "copyIdtoText();" } })
                @Html.ValidationMessageFor(model => model.USER_TEXT, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_NAME, "User Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "User Name" } })
                @Html.ValidationMessageFor(model => model.USER_NAME, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_PASS, "Password", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_PASS, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Password" } })
                @Html.ValidationMessageFor(model => model.USER_PASS, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_CONT, "Contact", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_CONT, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Contact" } })
                @Html.ValidationMessageFor(model => model.USER_CONT, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_LEVL, "Level", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.USER_LEVL, null, htmlAttributes: new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.USER_LEVL, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_TYPE, "Type", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_TYPE, new { htmlAttributes = new { @class = "form-control", required = "required", @Value = "NONE", placeholder = "Type" } })
                @Html.ValidationMessageFor(model => model.USER_TYPE, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_DEPT, "Department", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.USER_DEPT, null, htmlAttributes: new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.USER_DEPT, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_COMP, "Company", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.USER_COMP, null, htmlAttributes: new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.USER_COMP, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_ADMN, "Admin", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_ADMN, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "User Admin" } })
                @Html.ValidationMessageFor(model => model.USER_ADMN, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_ACTV, "Status", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.USER_ACTV, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.USER_ACTV, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.USER_IMAG, "Picture", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.USER_IMAG, new { htmlAttributes = new { @class = "form-control", placeholder = "d:/mypic.jpg" } })
                @Html.ValidationMessageFor(model => model.USER_IMAG, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<script>
    function copyIdtoText() {
        document.getElementById('USER_PASS').value = document.getElementById('USER_TEXT').value;
        document.getElementById('USER_ADMN').value = document.getElementById('USER_TEXT').value;
        document.getElementById('USER_CONT').value = '01';
        document.getElementById('USER_TYPE').value = 'NONE';
    }
</script>
@model IEnumerable<PM.ModelsV.AuditReportListVM>
@{
    ViewBag.Title = "Audit Without Report List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDIT_RPT_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TASK_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDIT_RPT_NAME)
                </th>


                <th>
                    @Html.DisplayNameFor(model => model.LOCATION_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_GROUP_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DEPARTMENT_ID)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.WORK_SCOPE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WORK_OPPORTUNITY)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CDU)
                </th>
                <th>#</th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="input-group-btn">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                Action
                                <span class="fa fa-caret-down"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <input type="submit" class="btn4 btn btn-flat btn-primary" value="Details View" data-url="@Url.Action("ViewAuditReportDetails", "Audit", new { id = item.AUDIT_RPT_ID })" />
                                </li>
                                <li>
                                    <input type="submit" class="FileUp btn btn-flat btn-primary" value="Attach File" data-url="@Url.Action("AttachFileAudit", "Audit", new { id = item.AUDIT_RPT_ID })" />
                                </li>
                                <li>
                                    <a href="@Url.Action("EditWithoutAuditReport", "Audit", new { id = item.AUDIT_RPT_ID })" , class="btn btn-flat btn-info">Edit</a>
                                </li>
                            </ul>
                        </div>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDIT_RPT_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TASK_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDIT_RPT_NAME)
                    </td>


                    <td>
                        @Html.DisplayFor(modelItem => item.LOCATION_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COMPANY_GROUP_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COMPANY_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DEPARTMENT_NAME)
                    </td>
                    <td>
                        @string.Format("{0:N}", item.WORK_SCOPE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.WORK_OPPORTUNITY)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.USER_NAME)
                    </td>
                    <td>
                        <a href="@Url.Action("DownloadAuditReportAttachFile", "Audit", new { id = item.AUDIT_RPT_ID })" , class="btn btn-flat btn-primary">Download File</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/Audit/_Update.js"></script>
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}







@model PM.ModelsV.ExcelInputVM
@{
    ViewBag.Title = "New Insurance BD";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div id="overlay" class="hide">
    <div class="loader">
    </div>
</div>


@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.MyExcelFile, new { type = "file", required = "required" })
                            <p class="help-block">.xlsx file format only and maximum 50 rows in Excel file</p>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">Load Excel File</button>
                            <a href="@Url.Action("InsuranceBD","Insurance")" class="btn btn-primary">Back</a>
                        </div>
                        <div class="col-md-4">
                            <span style="color:red">
                                <strong>
                                    @Html.ValidationMessageFor(x => x.MyExcelFile)
                                </strong>
                            </span>
                        </div>
                    </div>
                </div>
                <form id="NewUploadForm">
                    <div class="panel-body">
                        <div class="table-responsive">
                            @Html.Raw(Model.MSExcelTable)
                        </div>
                        <div class="table-responsive">
                            
                        </div>
                    </div>
                    <div class="panel-footer">
                        <button id="saveDatabase" type="submit" class="btn btn-primary">Check &amp; Upload</button>
                    </div>
                </form>
            </div>
            <div class="panel box box-danger">
                <div class="box-header with-border">
                    <h4 class="box-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" style="color:blue">
                            Excel Format
                        </a>
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse">
                    <div class="box-body">
                        <h4 style="color:red">NewInsuranceFile.xlsx</h4>
                        <table class="table" border="1">
                            <thead>
                                <tr>
                                    <th>PLATE_NO</th>
                                    <th>POLICY_NO</th>
                                    <th>ASET_VALUE</th>
                                    <th>PREMIUM_AMOUNT</th>
                                    <th>INSURANCE_COMPANY_NAME</th>
                                    <th>INSURANCE_COMPANY_ADDRESS</th>
                                    <th>REMARKS</th>
                                    <th>POLICY_DATE</th>
                                    <th>EXP_DATE</th>
                                    <th>VAT_AMOUNT</th>
                                    <th>PAYMENT_DATE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>ABC-1234</td>
                                    <td>XYZ-1999-001</td>
                                    <td>0</td>
                                    <td>130</td>
                                    <td>ABC Company</td>
                                    <td>ABC Co. H#12, Road#123</td>
                                    <td>New Insurance</td>
                                    <td>01-JAN-2020</td>
                                    <td>01-JAN-2021</td>
                                    <td>0</td>
                                    <td>25-DEC-2019</td>
                                </tr>
                                <tr>
                                    <td>ABC-1235</td>
                                    <td>XYZ-1999-002</td>
                                    <td>0</td>
                                    <td>130</td>
                                    <td>ABC Company</td>
                                    <td>ABC Co. H#12, Road#123</td>
                                    <td>New Insurance</td>
                                    <td>01-JAN-2020</td>
                                    <td>01-JAN-2021</td>
                                    <td>0</td>
                                    <td>25-DEC-2019</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.col-lg-4 -->
    </div>
}
@section scripts{
<script src="~/Scripts/Insurance/NewInsuranceBD.js"></script>
}
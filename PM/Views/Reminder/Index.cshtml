@model IEnumerable<PM.ModelsV.ReminderVM>

@{
    ViewBag.Title = "Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="~/bower_components/Custom.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "Reminder", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("Asset", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = " Asset / Item", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
                <!-- /btn-group -->
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewReminder", "Reminder")" class="btn btn-primary"> New Document</a>
            <a href="@Url.Action("Index","Reminder")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover" id="scrollNbuttonDT">
        <thead>
            <tr bgcolor="darkgray">
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.ASET_TAG)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ITEM_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.C_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.N_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMIND)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMINDER_NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NOTE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPLETED)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@item.REMINDER_NOTE">
                    <td>
                        <div class="input-group-btn">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                Action
                                <span class="fa fa-caret-down"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a href="@Url.Action("Download","Reminder", new { id=item.REMIND_ID})"  class="btn btn-info" >Download</a></li>
                                <li>
                                    <input type="submit" class="UpdateR form-control btn btn-flat btn-primary" value="Update Date" data-id=@item.REMIND_ID data-toggle="modal" data-target="#modal-edit" />
                                </li>
                                <li>
                                    <input type="submit" class="UpdateR form-control btn btn-flat btn-warning" value="Complete" data-id=@item.REMIND_ID data-toggle="modal" data-target="#modal-com" />
                                </li>@*
                                <li>
                                    <input type="submit" class="UpdateR form-control btn btn-flat btn-danger" value="Delete" data-id=@item.REMIND_ID data-toggle="modal" data-target="#modal-del" />                                    
                                </li>*@
                            </ul>
                        </div>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ASET_TAG)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ITEM_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.C_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.N_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMIND)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMINDER_NOTE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NOTE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COMPLETED)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section scripts{
    <script src="~/Scripts/Reminder/Index.js"></script>
}

<div class="modal fade" id="modal-edit">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Update</h5>
            </div>
            @using (Html.BeginForm("UpdateRange", "Reminder"))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="REMIND_ID" id="REMIND_ID" />
                    <div class="col-md-6">
                        <div class="form-group input-group">
                            <span class="input-group-addon">Start Date</span>
                            @Html.Editor("C_DATE", new { htmlAttributes = new { @class = "form-control", type = "date", id = "C_DATE", placeholder = "dd/mm/yyyy", required = "required" } })
                            @Html.ValidationMessage("C_DATE", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group input-group">
                            <span class="input-group-addon">End Date</span>
                            @Html.Editor("N_DATE", new { htmlAttributes = new { @class = "form-control", type = "date", id = "N_DATE", placeholder = "dd/mm/yyyy", required = "required" } })
                            @Html.ValidationMessage("N_DATE", "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary pull-left"><i class="fa fa-save"></i> Save</button>
                    <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Close</button>
                </div>
            }
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

<div class="modal fade" id="modal-del">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-danger">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">This action cannot be undone</h5>
            </div>
            @using (Html.BeginForm("DelReminder", "Reminder"))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="REMIND_DEL" id="REMIND_DEL" />
                    <p> Are you sure you want to delete this reminder?</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-trash"></i> Delete</button>
                    <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
                </div>
            }
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

<div class="modal fade" id="modal-com">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-warning">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">This action cannot be undone</h5>
            </div>
            @using (Html.BeginForm("Completed", "Reminder"))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="REMIND_COM" id="REMIND_COM" />
                    <p> Are you sure you want to complete this reminder?</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-left"><i class="fa fa-check"></i> Completed</button>
                    <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
                </div>
            }
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@model IEnumerable<PM.ModelsV.AuditorVM>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="btn-group margin">
            <a href="@Url.Action("NewAuditor", "Audit")" class="btn btn-primary"> New Auditor</a>
            <a href="@Url.Action("Index","Audit")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.AUDITOR_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDITOR_STAFF_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDITOR_MOBILE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AUDITOR_EMAIL)
                </th>
                <th>Status</th>
                <th>Action</th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDITOR_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDITOR_STAFF_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDITOR_MOBILE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUDITOR_EMAIL)
                    </td>
                    <td>
                        @if (item.ACT)
                        {
                            <span class="btn btn-success btn-xs">Active</span>
                        }
                        else
                        {
                            <span class="btn btn-danger btn-xs">Inactive</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("EditAuditor","Audit",
                                 new { id = item.AUDITOR_ID })"
                           class="btn btn-warning btn-xs">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}






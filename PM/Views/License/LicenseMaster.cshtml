@model IEnumerable<PM.ModelsV.LicenseMasterNM>
@{
    ViewBag.Title = "License Master";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("LicenseMaster", "License", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("License", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "License Number", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewLicense", "License")" class="btn btn-primary"> New License</a>
            <a href="@Url.Action("LicenseMaster","License")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>
<div class="table-responsive">
    @*<table class="table table-hover" id="scrollNbuttonDT">*@
    <table class="table table-hover" id="licenseListDataTable">
        <thead>
            <tr>
                <th>#</th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.COMPANY_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LIC_LOCATION_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_NUMBER)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_NAME_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ISSUING_AUTHORITY_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ISSUE_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EXPIRE_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_HOLDER_MOBILE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_HOLDER_EMAIL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_FEE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ENTERTAINMENT_FEE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ITEM_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.REMARK)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.APPLICATION_DATE)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LICENSE_STATUS_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CDU)
                </th>
                <th>
                    #
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="input-group-btn">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                Action
                                <span class="fa fa-caret-down"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <input type="submit" class="FileUp form-control btn btn-flat btn-primary" value="Update" data-url="@Url.Action("StatusUpdate","License", new { id= item.LICENSE_ID})" />
                                </li>
                                <li>
                                    <input type="submit" class="FileUp form-control btn btn-flat btn-primary" value="License Renew" data-url="@Url.Action("RenewLicense","License", new { id= item.LICENSE_ID})" />
                                </li>
                            </ul>
                        </div>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_ID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.COMPANY_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LOCATION_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_NUMBER)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AUTHORITY_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ISSUE_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EXPIRE_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_HOLDER_MOBILE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_HOLDER_EMAIL)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_FEE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ENTERTAINMENT_FEE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ITEM_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.REMARK)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.APPLICATION_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LICENSE_STATUS_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CDU)
                    </td>
                    <td>
                        <a href="@Url.Action("DownloadAttachFile", "License", new { id = item.LICENSE_ID })" , class="btn btn-flat btn-primary">Download File</a>

                    </td>





                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    @*<script src="~/Scripts/AssetUser/EditStaff.js"></script>*@
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}


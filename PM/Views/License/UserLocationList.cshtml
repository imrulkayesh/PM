@model IEnumerable<PM.ModelsV.LicenseUserLocationVM>
@{
    ViewBag.Title = "User Wise Location List";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("UserLocationList", "License", new { Operation = "Search" }))
        {
            <div class="input-group margin">
                <span class="input-group-addon">Search</span>
                @Html.Editor("License", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "User Location", autofocus = true, maxlength = "50" } })
                <div class="input-group-btn">
                    <button type="submit" class="viewAsset btn btn-primary">Submit</button>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("UserLocation", "License")" class="btn btn-primary"> New User Location</a>
            <a href="@Url.Action("UserLocationList","License")" class="btn btn-primary"><span class="fa fa-refresh"></span> Refresh</a>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-hover" id="scrollNbuttonDT">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.USER_TEXT)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.USER_NAME)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LIC_LOCATION_ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LOCATION_NAME)
                </th>
                
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.USER_TEXT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.USER_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.USER_LOCATION)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LOCATION_NAME)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="pvModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header btn-primary">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title">Action</h5>
            </div>
            <div class="modal-body" id="modalContainer">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning pull-right" data-dismiss="modal">Cancel</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
@section scripts{
    <script src="~/Scripts/Common/ConfirmBox.js"></script>
}






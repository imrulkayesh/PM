@model IEnumerable<PM.Models.P_ASSET>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("ASET_NAME", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="button" class="viewAsset btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewAsset", "KSAAssets")" class="btn btn-primary"> New Asset</a>
            <a href="@Url.Action("Index","KSAAssets")" class="btn btn-primary"><span class="fa fa-stack-overflow"></span> OK</a>
        </div>
    </div>
</div>
<div class="row">
    <div id="ViewEditPartialView"></div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>Last 10 Free Asset</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Engine
                            </th>
                            <th>
                                Chassis
                            </th>
                            <th>
                                Capacity
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Color
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Depot
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="input-group-btn">
                                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                            Action
                                            <span class="fa fa-caret-down"></span>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><input type="submit" class="addacce btn btn-primary" value="Add" data-asgrid=@item.ASET_ASGR data-assigned-id=@item.ASET_OID data-toggle="modal" data-target="#modal-view" /></li>
                                            <li><input type="submit" class="viewacce btn btn-sm btn-primary" value="View" data-vhclid=@item.ASET_OID data-toggle="modal" data-target="#modal-view" /></li>
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_MODL)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TYPE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ENGN_PONO)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CHSS_GRN)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_CPCT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_PRIC)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.REG_DATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_IMAG)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_COLR)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MFG_YEAR)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NOTE)
                                </td>
                                <td>
                                    @if (item.ISBOOKED == false)
                                    { <p>free</p> }
                                    else
                                    { <p>booked</p> }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_ASGR.ASGR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_DEPT.DEPT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_AREA.AREA_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_BRAND.BRND_NAME)
                                </td>
                                <td>
                                    @if (item.ASET_ACTV == true)
                                    { <p>Active</p> }
                                    else
                                    { <p>Damage</p> }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Engine
                            </th>
                            <th>
                                Chassis
                            </th>
                            <th>
                                Capacity
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Color
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Depot
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>



@section scripts{
<script src="~/Scripts/KSAAssets/inde.js"></script>
}

<div class="modal fade" id="modal-view">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">Asset Accesories</h4>
            </div>
            <div class="modal-body">
                <div id="ViewEditPartialViewModal">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->

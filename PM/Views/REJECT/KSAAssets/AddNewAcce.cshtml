@model PM.Models.P_ASSET_ACCE

@{
//ViewBag.Title = "New Acce";
//Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="margin form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Acce Name</span>
                @Html.DropDownList("ACCE_ASAC", null,"--Select Item--", htmlAttributes: new { @class = "form-control" ,required="required"})
                @Html.ValidationMessageFor(model => model.ACCE_ASAC, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Asset</span>
                @Html.DropDownList("ACCE_ASET", null, htmlAttributes: new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.ACCE_ASET, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Qty</span>
                @Html.EditorFor(model => model.ACCE_QTY, new { htmlAttributes = new { @class = "form-control",type="number",required="required" } })
                @Html.ValidationMessageFor(model => model.ACCE_QTY, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Price</span>
                @Html.EditorFor(model => model.ACCE_PRICE, new { htmlAttributes = new { @class = "form-control",type= "number", required = "required" } })
                @Html.ValidationMessageFor(model => model.ACCE_PRICE, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Issue Date</span>
                @Html.EditorFor(model => model.ACCE_DATE, new { htmlAttributes = new { @class = "form-control", type = "date",required="required" } })
                @Html.ValidationMessageFor(model => model.ACCE_DATE, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10 input-group">
                <span class="input-group-addon">Note</span>
                @Html.EditorFor(model => model.ACCE_NOTE, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                @Html.ValidationMessageFor(model => model.ACCE_NOTE, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10">
                <input type="submit" value="Add" class="btn btn-primary" />
            </div>
        </div>
    </div>
}
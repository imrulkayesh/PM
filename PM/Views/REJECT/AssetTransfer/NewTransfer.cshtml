@model PM.Models.P_ASSET_TRNS

@{
    ViewBag.Title = "Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Raw(TempData["msg"])

<div id="myElem" style="display:none" class="alert alert-success alert-dismissible mb-2" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">×</span>
    </button>
    <strong>Well done!</strong> You successfully read this
    <a href="#" class="alert-link">important</a> alert message.
</div>


<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                New Transfer
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">
                <div class="col-md-12">
                    @using (Html.BeginForm("SaveTransfer", "AssetTransfer", FormMethod.Post, new { enctype = "multipart/form-data", id = "AssetTransfer" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="margin form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">Asset</span>
                                            @Html.DropDownList("TRNS_ASET", null, "--Select Asset--", htmlAttributes: new { @class = "form-control select2", required = "required", onchange = "getAssetData();" })
                                            @Html.ValidationMessageFor(model => model.TRNS_ASET, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">Issue Date</span>
                                            @Html.EditorFor(model => model.TRNS_DATE, new { htmlAttributes = new { @class = "form-control", type = "date", required = "required" } })
                                            @Html.ValidationMessageFor(model => model.TRNS_DATE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">Note</span>
                                            @Html.EditorFor(model => model.TRNS_NOTE, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.TRNS_NOTE, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    @*<div class="form-group">
                                            <div class="col-md-10 input-group">
                                                <span class="input-group-addon">Post</span>
                                                @Html.CheckBoxFor(model => model.TRNS_POST, new { htmlAttributes = new { @class = "form-control"} })
                                            </div>
                                        </div>*@
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">From User</span>
                                            @Html.DropDownList("TRNS_FUSER", Enumerable.Empty<SelectListItem>(), "--select from user--", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_FUSER, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">To User</span>
                                            @Html.DropDownList("TRNS_TUSER", null, "--select to user--", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_TUSER, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">From Company</span>
                                            @Html.DropDownList("TRNS_FDEPT1", Enumerable.Empty<SelectListItem>(), "--select from company--", htmlAttributes: new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(model => model.TRNS_FDEPT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">To Company</span>
                                            @Html.DropDownList("TRNS_TCOMP", null, "--select to company--", htmlAttributes: new { @class = "form-control select2", required = "required", onChange = "getToDeptList();" })
                                            @Html.ValidationMessageFor(model => model.TRNS_TDEPT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">From Depart</span>
                                            @Html.DropDownList("TRNS_FDEPT", Enumerable.Empty<SelectListItem>(), htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_FDEPT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">To Depart</span>
                                            @Html.DropDownList("TRNS_TDEPT", Enumerable.Empty<SelectListItem>(), "--select to department--", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_TDEPT, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">From Depo</span>
                                            @Html.DropDownList("TRNS_FDEPO", Enumerable.Empty<SelectListItem>(), htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_FDEPO, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <span class="input-group-addon">To Depo</span>
                                            @Html.DropDownList("TRNS_TDEPO", null, "--select to depot--", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                            @Html.ValidationMessageFor(model => model.TRNS_TDEPO, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon">New Item</span>
                                            @Html.DropDownList("AcceNameNew", Enumerable.Empty<SelectListItem>(), "--Acce. Item--", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon">Qty</span>
                                            @Html.Editor("AcceQtyNew", new { htmlAttributes = new { @class = "form-control", type = "number", required = "required", placeholder = "Qty", min = "1" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon">Price</span>
                                            @Html.Editor("AccePriceNew", new { htmlAttributes = new { @class = "form-control", type = "number", required = "required", placeholder = "Price", min = "1" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon">Note</span>
                                            @Html.Editor("AcceNoteNew", new { htmlAttributes = new { @class = "form-control", placeholder = "Notes" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <div class="col-md-10 input-group">
                                            <a id="addToList" href="#" class="btn btn-primary btn-flat btn-sm">Add to List</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr />
                        </div>
                        <div id="ViewEditPartialView" class="table-responsive"></div>

                    }
                    <hr />
                </div>
            </div>
            <div class="panel-footer">
                <button id="saveOrder" type="submit" class="btn btn-danger btn-flat pull-right">Save Now</button>
                <a href="@Url.Action("Index","AssetTransfer")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/Scripts/AssetTransfer/NewTransfer.js"></script>
}
@model IEnumerable<PM.Models.P_ASSET_ACCE>

@{
    Layout = null;
}

<table class="table table-bordered table-condensed table-hover table-responsive" id="AcceListTable">
    <thead>
        <tr>
            <th style="color:red">
                <strong>Select</strong>
            </th>
            <th>
                Id
            </th>
            <th>
                Acce Name
            </th>
            <th>
                Asset
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Qty
            </th>
            <th>
                issue Qty
            </th>
            <th>
                Price
            </th>
            <th>
                Issue Date
            </th>
            <th>
                Note
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td bgcolor="#ff9999">
                    <input type="checkbox" class="checkBoxClass" id="@item.P_ASAC.ASAC_TEXT" checked/>
                </td>
                <td>
                    @Html.EditorFor(modelItem => item.P_ASAC.ASAC_TEXT, new { htmlAttributes = new { @class = "form-control", required = "required", disabled = "disabled" } })
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.P_ASAC.ASAC_NAME)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.P_ASSET.ASET_TEXT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.P_OWNR.OWNR_TEXT)
                </td>              
                <td>
                    @Html.DisplayFor(modelItem => item.P_OWNR1.OWNR_TEXT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ACCE_QTY)
                </td>
                <td>
                    @Html.EditorFor(modelItem => item.ACCE_QTY, new { htmlAttributes = new { @class = "form-control", required = "required", min = "1" } })
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ACCE_PRICE)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ACCE_DATE)
                </td>
                <td>
                    @Html.EditorFor(modelItem => item.ACCE_NOTE, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                </td>
            </tr>
        }
    </tbody>
</table>
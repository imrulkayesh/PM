@model PM.Models.P_INSC

@{
    ViewBag.Title = "NewExpenses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                New Insurance
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">
                @using (Html.BeginForm())
                {
                @Html.AntiForgeryToken()

                <div class="form-horizontal col-md-6">
                    @Html.ActionLink("Back to List", "Index")
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        @Html.Label("Group", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("INSC_GU", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%", required = "required" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("BU", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("INSC_BU", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%", required = "required", onchange = "GetAssets();" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.INSC_ASET, "Asset", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("INSC_ASET", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", name = "INSC_ASET", id = "INSC_ASET" , onchange = "GetHist();" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.INSC_PLCY, "Policy", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.INSC_PLCY, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.INSC_PREM, "Premium", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.INSC_PREM, new { htmlAttributes = new { @class = "form-control", required = "required" ,type="number"} })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.INSC_RDAT, "Renew Date", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.INSC_RDAT, new { htmlAttributes = new { @class = "form-control", type = "date", required = "required" } })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.INSC_NOTE, "Note", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.INSC_NOTE, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
                }
                <div class="form-horizontal col-md-6 table-responsive">
                <div id="ViewEditPartialView"></div>
                </div>
            </div>
            <div class="panel-footer">
                New Insurance Entry
            </div>
        </div>
    </div>
</div>




@section scripts{
    <script type="text/javascript" language="javascript">
        function GetAssets() {
            var url = '@Url.Action("GetAssets", "Insurance")';
            var INSC_ASET = $('#INSC_ASET');
            var Group = $('#INSC_GU').val();
            var Business = $('#INSC_BU').val();
            $.getJSON(url, { Group: Group, Business: Business }, function (response) {
                INSC_ASET.empty();
                INSC_ASET.append($("<option></option>").attr("value", '').text('--Select Asset--'));
                $.each(response, function (index, item) {
                    INSC_ASET.append($("<option></option>").attr("value", item.ASET_OID).text(item.ASET_NAME));
                });
            });
        };

        function GetHist() {
            var id = $('#INSC_ASET').val();
            var route = '@Url.Action("InsuranceHistory", "Insurance")?AsetId=' + id;
            $('#ViewEditPartialView').load(route);
        };
    </script>

}

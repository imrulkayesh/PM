@model IEnumerable<PM.Models.P_OWNR>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Raw(TempData["msg"])
<div class="row">
    <div class="col-md-6">
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("OWNR_USER", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "User Id", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="button" class="viewOwner btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewAssetUser", "AssetUserList")" class="btn btn-primary"> New User</a>
            <a href="@Url.Action("Index", "AssetUserList")" class="btn btn-primary"> OK</a>
        </div>
    </div>
</div>
<div class="row">
    <div id="ViewEditPartialView"></div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>Just 10 User</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>
                                Staff Id
                            </th>
                            <th>
                                Iqama No
                            </th>
                            <th>
                                Staff Name
                            </th>
                            <th>
                                Designation
                            </th>
                            <th>
                                Contact
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                Picture
                            </th>
                            <th>
                                Iqama Exipre
                            </th>
                            <th>
                                Resign
                            </th>
                            <th>
                                Resign Date
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                               Depot
                            </th>
                            <th>
                              Active
                            </th>
                            <th>
                              Email
                            </th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_AST_IMAG)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_USER)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_CONTACT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_ADDRESS)
                                </td>
                                <td>
                                    @if (item.OWNR_IMAG != null)
                                    {
                                        <a target="_blank" href="@Url.Action("ViewImages", new { id=item.OWNR_OID, imgtype="OP" })" class="fa fa-file-image-o"> View</a>
                                    }
                                    else
                                    {
                                        <p>No Pic</p>
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_TAKE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_RESIGN)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_RES_DATE)
                                </td>  
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_NOTE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_DEPT.DEPT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_AREA.AREA_NAME)
                                </td>
                                <td>
                                    @if (item.OWNR_ACTV == true)
                                    {
                                        <p>Active</p>
                                    }else
                                    {
                                        <p>Inactive</p>
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_EMAIL)
                                </td>                                
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>
                                Staff Id
                            </th>
                            <th>
                                Iqama No
                            </th>
                            <th>
                                Staff Name
                            </th>
                            <th>
                                Designation
                            </th>
                            <th>
                                Contact
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                Picture
                            </th>
                            <th>
                                Iqama Exipre
                            </th>
                            <th>
                                Resign
                            </th>
                            <th>
                                Resign Date
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Depot
                            </th>
                            <th>
                                Active
                            </th>
                            <th>
                                Email
                            </th>
                            <th>#</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>



@section scripts{
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('#OWNR_USER').autocomplete({
                source: '@Url.Action("getSuggession")'
            });
        });

        $(function () {
            $('.viewOwner').click(function () {
                var id = $('#OWNR_USER').val();
                var route = '@Url.Action("SingleOwnerView", "AssetOwner")?AssetName=' + id;
                $('#ViewEditPartialView').load(route);
            });
        });
    </script>
}


@model PM.Models.P_ASSET_DAMAGE

@{
    ViewBag.Title = "Application";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                Apply for Damage/Lost/Ownership
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">
                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Name</span>
                                @Html.DropDownListFor(model => model.ASET_OID, null, htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_OID, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Reason</span>
                                @Html.EditorFor(model => model.DMG_APP, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Write Reason" } })
                                @Html.ValidationMessageFor(model => model.DMG_APP, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Date of App</span>
                                @Html.EditorFor(model => model.DMG_DATE, new { htmlAttributes = new { @class = "form-control", required = "required",type="date"} })
                                @Html.ValidationMessageFor(model => model.DMG_DATE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Price</span>
                                @Html.EditorFor(model => model.DMG_PRICE, new { htmlAttributes = new { @class = "form-control", placeholder = "Amount" } })
                                @Html.ValidationMessageFor(model => model.DMG_PRICE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">App Type</span>
                                @Html.DropDownListFor(model => model.DMG_TYPE, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required"})
                                @Html.ValidationMessageFor(model => model.DMG_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset User</span>
                                @Html.DropDownListFor(model => model.DMG_USR, null,  htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                                @Html.ValidationMessageFor(model => model.DMG_USR, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Apply</button>
                                <a href="@Url.Action("Index","AssetEntry")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="panel-footer">
                Damage/Lost/Ownership Application
            </div>
        </div>
    </div>
</div>


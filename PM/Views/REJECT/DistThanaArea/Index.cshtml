@model IEnumerable<PM.Models.P_AREA>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="col-md-6">
        <div class="box">
            <div class="box-header">
                <p>District Thana and Base/Area</p>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="scrollNbuttonDT" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>
                                District
                            </th>
                            <th>
                                Thana
                            </th>
                            <th>
                                Base Id
                            </th>
                            <th>
                                Area/Base
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_THNA.P_DIST.DIST_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_THNA.THNA_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.AREA_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.AREA_NAME)
                                </td>
                                <td>
                                    @if (item.AREA_ACTV == true)
                                    {
                                        <p class="fa fa-check-square" />
                                    }
                                    else
                                    {
                                        <p class="fa fa-close" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>
                                District
                            </th>
                            <th>
                                Thana
                            </th>
                            <th>
                                Base Id
                            </th>
                            <th>
                                Area/Base
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>
@{
    ViewBag.Title = "ReportPRAN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- /.col-lg-4 -->
<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    PRAN Asset
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm("ViewPRANReport", "ReportPRAN"))
                    {
                    <div class="col-md-3">
                        <div class="col-md-10 input-group">
                            <span class="input-group-addon">Group</span>
                            @Html.DropDownList("MyGroup", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="col-md-10 input-group">
                            <span class="input-group-addon">BU</span>
                            @Html.DropDownList("MyBU", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="col-md-10 input-group">
                            <span class="input-group-addon">Type</span>
                            @Html.DropDownList("AssetType", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="col-md-10 input-group">
                            <button class="btn btn-primary" type="submit">Download</button>
                        </div>
                    </div>
                    }
                </div>
                <div class="panel-footer">
                    Report v.0.2
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    PRAN Asset Owner
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm("PRANAssetByUser", "ReportPRAN"))
                    {
                        <div class="col-md-2">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Group</span>
                                @Html.DropDownList("MyGroup", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">BU</span>
                                @Html.DropDownList("MyBU", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Type</span>
                                @Html.DropDownList("AssetType", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Brand</span>
                                @Html.DropDownList("ASET_BRND", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;" })
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="col-md-10 input-group">
                                <button class="btn btn-primary" type="submit">Download</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="panel-footer">
                    Report v.0.1
                </div>
            </div>
        </div>
    </div>
</div>
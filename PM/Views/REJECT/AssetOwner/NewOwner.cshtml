@model PM.Models.P_OWNR

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}
<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                New Owner
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">
                @using (Html.BeginForm("NewOwner", "AssetOwner", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Outlet Id</span>
                                @Html.EditorFor(model => model.OWNR_TEXT, new { htmlAttributes = new { @class = "form-control", placeholder = "Outlet Id [Auto]", maxlength = "50", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.OWNR_TEXT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Outlet Name</span>
                                @Html.EditorFor(model => model.OWNR_USER, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Outlet Name", autofocus = true, maxlength = "50" } })
                                @Html.ValidationMessageFor(model => model.OWNR_USER, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Address</span>
                                @Html.EditorFor(model => model.OWNR_ADDRESS, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Address", maxlength = "120" } })
                                @Html.ValidationMessageFor(model => model.OWNR_ADDRESS, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Proprietor</span>
                                @Html.EditorFor(model => model.OWNR_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Proprietor Name" } })
                                @Html.ValidationMessageFor(model => model.OWNR_NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Contact</span>
                                @Html.EditorFor(model => model.OWNR_CONTACT, new { htmlAttributes = new { @class = "form-control", placeholder = "Contact or Mobile No" } })
                                @Html.ValidationMessageFor(model => model.OWNR_CONTACT, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Outlet Picture</span>
                                <input type="file" name="files" id="OWNR_IMAG" class="form-control">
                                <p class="help-block">*.jpg,*.jpeg,*.png files only</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Take Date</span>
                                @Html.EditorFor(model => model.OWNR_TAKE, new { htmlAttributes = new { @class = "form-control", type = "date", required = "required" } })
                                @Html.ValidationMessageFor(model => model.OWNR_TAKE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Picture</span>
                                <input type="file" name="files" id="OWNR_AST_IMAG" class="form-control">
                                <p class="help-block">*.jpg,*.jpeg,*.png files only</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Deed Picture</span>
                                <input type="file" name="files" id="OWNR_DED_IMAG" class="form-control">
                                <p class="help-block">*.jpg,*.jpeg,*.png files only</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Type</span>
                                @Html.EditorFor(model => model.OWNR_TYPE, new { htmlAttributes = new { @class = "form-control", placeholder = "Staff/Retailer" } })
                                @Html.ValidationMessageFor(model => model.OWNR_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Note</span>
                                @Html.EditorFor(model => model.OWNR_NOTE, new { htmlAttributes = new { @class = "form-control", placeholder = "Note", maxlength = "250" } })
                                @Html.ValidationMessageFor(model => model.OWNR_NOTE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Area</span>
                                @Html.DropDownListFor(model => model.OWNR_AREA, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.OWNR_AREA, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Dept</span>
                                @Html.DropDownListFor(model => model.OWNR_DEPT, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required",onchange= "getAssetList();" })
                                @Html.ValidationMessageFor(model => model.OWNR_DEPT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset</span>
                                @Html.DropDownListFor(model => model.OWNR_ASET, Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.OWNR_ASET, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                                <a href="@Url.Action("Index","AssetOwner")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="panel-footer">
                New Owner Entry
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        function getAssetList() {
            var url = '@Url.Action("getAssetList", "AssetOwner")';
            var OWNR_ASET = $('#OWNR_ASET');
            var id = $('#OWNR_DEPT').val();
            $.getJSON(url, { deptId: id }, function (response) {
                OWNR_ASET.empty();
                OWNR_ASET.append($("<option></option>").attr("value", '').text('--Select Asset--'));
                $.each(response, function (index, item) {
                    OWNR_ASET.append($("<option></option>").attr("value", item.ASET_OID).text(item.ASET_TEXT));
                });
            });
        };
        $(document).ready(function () {
            $('#OWNR_USER').autocomplete({
                source: '@Url.Action("Autocomplete")'
            });
        });
    </script>

}
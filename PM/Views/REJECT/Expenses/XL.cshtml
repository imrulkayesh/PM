@model PM.Models.ExcelUpload
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="/bower_components/Spinner.css" rel="stylesheet" />
}
<div id="overlay">
    <div class="cv-spinner">
        <span class="spinner"></span>
    </div>
</div>


@using (Html.BeginForm("XL", "Expenses", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <div class="row">
                        <div class="col-md-3">
                            @Html.TextBoxFor(x => x.MyExcelFile, new { type = "file" })
                            <p class="help-block">.xlsx file format only and maximum 50 data</p>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">Upload</button>
                            <a href="@Url.Action("Index","Expenses")" class="btn btn-primary">Back</a>
                        </div>
                        <div class="col-md-4">
                            <span style="color:red">
                                <strong>
                                    @Html.ValidationMessageFor(x => x.MyExcelFile)
                                </strong>
                            </span>
                        </div>
                    </div>
                </div>
                <form id="NewUploadForm">
                    <div class="panel-body">
                        <div class="table-responsive">
                            @Html.Raw(Model.MSExcelTable)
                        </div>
                    </div>
                    <div class="panel-footer">
                        <button id="saveDatabase" type="submit" class="btn btn-danger">Save</button>
                    </div>
                </form>
            </div>
            <div class="panel box box-danger">
                <div class="box-header with-border">
                    <h4 class="box-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" style="color:blue">
                            Excel Format
                        </a>
                    </h4>
                </div>
                <div id="collapseTwo" class="panel-collapse collapse">
                    <div class="box-body">
                        <h4 style="color:red">BikeExpenses.xlsx</h4>
                        <img class="img-responsive pad" src="~/SampleEmage/BikeExpenses.jpg" alt="PRANAssetExcel.xlsx">
                    </div>
                </div>
            </div>
        </div>
        <!-- /.col-lg-4 -->
    </div>
}



@section scripts{
    <script>
        // After Add A New Asset In The List, If You Want, You Can Remove It.
        $(document).on('click', 'a.deleteItem', function (e) {
            e.preventDefault();
            var $self = $(this);
            if ($(this).attr('data-itemId') == "0") {
                $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                    $(this).remove();
                });
            }
        });
        //After Click Save Button Pass All Data View To Controller For Save Database
        function saveAsset(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: "/Expenses/ExcelSave",
                data: data,
                beforeSend: function () {
                    $('#overlay').show();    /*showing  a div with spinning image */
                },
                success: function (result) {
                    alert(result);
                    //location.reload();
                    location.href = "/Expenses/Index";
                },
                error: function () {
                    alert("Error! Data Not Upload")
                },
                complete: function () {
                    $('#overlay').hide();
                }
            });
        }
        //Collect Multiple Asset List For Pass To Controller
        $("#saveDatabase").click(function (e) {
            e.preventDefault();

            var assetArr = [];
            assetArr.length = 0;

            $.each($("#table1 tbody tr"), function () {
                assetArr.push({
                    ASET_OID: $(this).find('td:eq(1)').html(),
                    EXPH_TEXT: $(this).find('td:eq(2)').html(),
                    EXPD_AMNT: $(this).find('td:eq(3)').html(),
                    EXPD_DATE: $(this).find('td:eq(4):last').html(),
                    EXPD_NOTE: $(this).find('td:eq(5)').html(),
                });
            });

            var data = JSON.stringify({
                htmlDataToModel: assetArr
            });

            $.when(saveAsset(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });
        });
    </script>
}
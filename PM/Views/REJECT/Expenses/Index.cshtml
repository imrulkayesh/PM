@model IEnumerable<PM.Models.VN_EXPD_XL>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-4">
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("AssetName", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="button" class="viewAsset btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
    </div>
    <div class="col-md-4">
        <div class="input-group margin">
            <div class="row">
                @*<a href="@Url.Action("XL","Expenses")" class="btn btn-primary"><span class="fa fa-stack-overflow"></span> Upload New XL</a>*@
                <a href="@Url.Action("NewExpenses","Expenses")" class="btn btn-primary"><span class="fa fa-plus-square-o"></span> New Expenses</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
               <div id="ViewEditPartialView">
                   
               </div>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>Waitting for Posting</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>
                                Asset Name
                            </th>
                            <th>
                                Expenses
                            </th>
                            <th>
                                Amount
                            </th>
                            <th>
                                User
                            </th>
                            <th>
                                Date
                            </th>
                            <th>
                                Note
                            </th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.ActionLink("DONE", "SendToDetail", new { id = item.ASET_OID })
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EXPH_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EXPD_AMNT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EXPD_USER)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EXPD_DATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.EXPD_NOTE)
                                </td>
                                <td>
                                    @Html.ActionLink("Edit", "Edit", new { id = item.ASET_OID }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.ASET_OID })
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>
                                Asset Name
                            </th>
                            <th>
                                Expenses
                            </th>
                            <th>
                                Amount
                            </th>
                            <th>
                                User
                            </th>
                            <th>
                                Date
                            </th>
                            <th>
                                Note
                            </th>
                            <th>#</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>#</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                @*@{
                    @Html.Action("AuthorizePost")
                }*@

            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>



@section scripts{
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('#AssetName').autocomplete({
                source: '@Url.Action("getSuggession")'
            });
        });

        $(function () {
            $('.viewAsset').click(function () {
                var id = $('#AssetName').val();
                var route = '@Url.Action("SingleExpensesView", "Expenses")?AssetName=' + id;
                $('#ViewEditPartialView').load(route);
            });
        });
    </script>
}

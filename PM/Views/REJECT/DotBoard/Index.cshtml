
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var AllAsset = ViewBag.TotalAssetQty;

    var InService = (ViewBag.TotalInService * 100) / ViewBag.TotalAssetQty;
    var AllLost = (ViewBag.TotalLost * 100) / ViewBag.TotalAssetQty;

    var InUse = (ViewBag.TotalInUse * 100) / ViewBag.TotalAssetQty;
    var NotInUse = (ViewBag.TotalNotInUse * 100) / ViewBag.TotalAssetQty;
}



<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 class="box-title">Latest Updates</h3>
                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse">
                            <i class="fa fa-minus"></i>
                        </button>
                        <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                    </div>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <p class="text-center">
                        <strong>Summary of A</strong>
                    </p>
                    <div class="progress">
                        <div class="progress-bar progress-bar-success" role="progressbar" style="width:0%">
                            In Service
                        </div>
                        <div class="progress-bar progress-bar-warning" role="progressbar" style="width:@InService%">
                          @InService %  In Service
                        </div>
                        <div class="progress-bar progress-bar-danger" role="progressbar" style="width:@AllLost%">
                            Lost / Ownership
                        </div>
                    </div>
                    <div class="progress">
                        <div class="progress-bar progress-bar-success" role="progressbar" style="width:10%">
                          100%  In Service
                        </div>
                        <div class="progress-bar progress-bar-warning" role="progressbar" style="width:20%">
                         @InUse %   In Use
                        </div>
                        <div class="progress-bar progress-bar-danger" role="progressbar" style="width:10%">
                          @NotInUse %  Not In Use
                        </div>
                    </div>

                </div>
                <!-- /.box-body -->
                <div class="box-footer text-center">
                    Status
                </div>
                <!-- /.box-footer -->
            </div>
            <!-- /.box -->



        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Latest Updates</h3>
                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse">
                            <i class="fa fa-minus"></i>
                        </button>
                        <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                    </div>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <p class="text-center">
                        <strong>Summary of A</strong>
                    </p>
                    <div class="progress-group">
                        <span class="progress-text">Not In Use</span>
                        <span class="progress-number"><b>@ViewBag.TotalNotInUse</b>/@AllAsset</span>
                        <div class="progress sm">
                            <div class="progress-bar progress-bar-light-blue" style="width: 100%"></div>
                        </div>
                    </div>
                    <!-- /.progress-group -->
                    <div class="progress-group">
                        <span class="progress-text">In Use</span>
                        <span class="progress-number"><b>@ViewBag.TotalInUse</b>/@AllAsset</span>
                        <div class="progress sm">
                            <div class="progress-bar progress-bar-yellow" style="width: 100%"></div>
                        </div>
                    </div>
                    <!-- /.progress-group -->
                    <div class="progress-group">
                        <span class="progress-text">In Service</span>
                        <span class="progress-number"><b>@ViewBag.TotalInService</b>/@AllAsset</span>
                        <div class="progress sm">
                            <div class="progress-bar progress-bar-red" style="width: 100%"></div>
                        </div>
                    </div>
                    <!-- /.progress-group -->
                    <div class="progress-group">
                        <span class="progress-text">Lost and Ownership</span>
                        <span class="progress-number"><b>@ViewBag.TotalLost</b>/@AllAsset</span>
                        <div class="progress sm">
                            <div class="progress-bar progress-bar-green" style="width: 100%"></div>
                        </div>
                    </div>
                    <!-- /.progress-group -->
                    <div class="progress-group">
                        <span class="progress-text">Total Asset</span>
                        <span class="progress-number"><b>@AllAsset</b>/@AllAsset</span>
                        <div class="progress sm">
                            <div class="progress-bar progress-bar-aqua" style="width: 100%"></div>
                        </div>
                    </div>
                    <!-- /.progress-group -->
                </div>
                <!-- /.box-body -->
                <div class="box-footer text-center">
                    Status
                </div>
                <!-- /.box-footer -->
            </div>
            <!-- /.box -->
        </div>
    </div>
</div>
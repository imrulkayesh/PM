@model IEnumerable<PM.Models.P_ASSET>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("ASET_NAME", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="button" class="viewAsset btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewBike", "BikeEntry")" class="btn btn-primary"> New Asset</a>
            @*<a href="@Url.Action("UploadExcel", "BikeEntry")" class="btn btn-primary"> Excel Input</a>*@
        </div>
    </div>
</div>
<div class="row">
    <div id="ViewEditPartialView"></div>
</div>



<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>Last 10 Free Asset</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                ENG
                            </th>
                            <th>
                               CHSS
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Fuel
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Area
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @*    @Html.ActionLink("Edit", "Edit", new { id = item.ASET_OID })
                                        @Html.ActionLink("Details", "Details", new { id = item.ASET_OID }) |
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ASET_OID })*@
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_MODL)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TYPE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ENGN_PONO)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CHSS_GRN)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_PRIC)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.REG_DATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_IMAG)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FUEL_TYPE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MFG_YEAR)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NOTE)
                                </td>
                                <td>
                                    @if (item.ISBOOKED == false)
                                    { <p>free</p> }
                                    else
                                    { <p>booked</p> }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_ASGR.ASGR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_DEPT.DEPT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_AREA.AREA_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_BRAND.BRND_NAME)
                                </td>
                                <td>
                                    @if (item.ASET_ACTV == true)
                                    { <p>Active</p> }
                                    else
                                    { <p>unknown</p> }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                ENG
                            </th>
                            <th>
                                CHSS
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Fuel
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Area
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>



@section scripts{
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('#ASET_NAME').autocomplete({
                source: '@Url.Action("getSuggession")'
            });
        });
        $(function () {
            $('.viewAsset').click(function () {
                var id = $("#ASET_NAME").val();
                var route = '@Url.Action("SingleBikeView", "BikeEntry")?BikeName=' + id;
                $('#ViewEditPartialView').load(route);
                console.log($("#ASET_NAME").val());
            });
        });
    </script>
}
@model IEnumerable<PM.Models.P_ASSET>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>Asset List</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Engine
                            </th>
                            <th>
                                Chassis
                            </th>
                            <th>
                                Capacity
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Color
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Depot
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="input-group-btn">
                                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                                            Action
                                            <span class="fa fa-caret-down"></span>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a href="@Url.Action("History","TransferData", new { id=item.ASET_OID})">View History</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_MODL)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_TYPE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ENGN_PONO)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CHSS_GRN)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_CPCT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_PRIC)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.REG_DATE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_IMAG)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_COLR)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MFG_YEAR)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ASET_NOTE)
                                </td>
                                <td>
                                    @if (item.ISBOOKED == false)
                                    { <p>free</p> }
                                    else
                                    { <p>booked</p> }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_ASGR.ASGR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_DEPT.DEPT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_AREA.AREA_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_BRAND.BRND_NAME)
                                </td>
                                <td>
                                    @if (item.ASET_ACTV == true)
                                    { <p>Active</p> }
                                    else
                                    { <p>Damage</p> }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>
                                Code
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Model
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Engine
                            </th>
                            <th>
                                Chassis
                            </th>
                            <th>
                                Capacity
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                RegDate
                            </th>
                            <th>
                                Image
                            </th>
                            <th>
                                Color
                            </th>
                            <th>
                                Year
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Book
                            </th>
                            <th>
                                Group
                            </th>
                            <th>
                                Department
                            </th>
                            <th>
                                Depot
                            </th>
                            <th>
                                Brand
                            </th>
                            <th>
                                Status
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>


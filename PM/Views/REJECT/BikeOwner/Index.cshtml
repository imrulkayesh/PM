@model IEnumerable<PM.Models.P_OWNR>

@{
    ViewBag.Title = "Index-Bike Owner";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <div class="input-group margin">
            <span class="input-group-addon">Search</span>
            @Html.Editor("OWNR_USER", new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, maxlength = "50" } })
            <div class="input-group-btn">
                <button type="button" class="viewOwner btn btn-primary">Submit</button>
            </div>
            <!-- /btn-group -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="btn-group margin">
            <a href="@Url.Action("NewOwner", "BikeOwner")" class="btn btn-primary"> New Owner</a>
            @*<a href="@Url.Action("Index", "AssetOwner")" class="btn btn-primary"> Excel Input</a>*@
        </div>
    </div>
</div>
<div class="row">
    <div id="ViewEditPartialView"></div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h4>10 Asset Owner</h4>
            </div>
            <!-- /.box-header -->
            <div class="box-body table-responsive">
                <table id="" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>
                                User/Staff
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Designation
                            </th>
                            <th>
                                Contact
                            </th>
                            <th>
                                Email
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                User Picture
                            </th>
                            <th>
                                Taken
                            </th>
                            <th>
                                Asset Pic
                            </th>
                            <th>
                                Deed Pic
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Area
                            </th>
                            <th>
                                Dept
                            </th>
                            <th>
                                Asset Name
                            </th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_TEXT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_USER)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_CONTACT)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_EMAIL)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_ADDRESS)
                                </td>
                                <td>
                                    @if (item.OWNR_IMAG != null)
                                    {
                                        <a target="_blank" href="@Url.Action("ViewImages", new { id=item.OWNR_OID, imgtype="OP" })" class="fa fa-file-image-o"> View</a>
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_TAKE)
                                </td>
                                <td>
                                    @if (item.OWNR_AST_IMAG != null)
                                    {
                                        <a target="_blank" href="@Url.Action("ViewImages", new { id=item.OWNR_OID, imgtype="AP" })" class="fa fa-file-image-o"> View</a>
                                    }
                                </td>

                                <td>
                                    @if (item.OWNR_DED_IMAG != null)
                                    {
                                        <a target="_blank" href="@Url.Action("ViewImages", new { id=item.OWNR_OID, imgtype="DC" })" class="fa fa-file-image-o"> View</a>
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_TYPE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.OWNR_NOTE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_AREA.AREA_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_DEPT.DEPT_NAME)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.P_ASSET.ASET_TEXT)
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>
                                User/Staff
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Designation
                            </th>
                            <th>
                                Contact
                            </th>
                            <th>
                                Email
                            </th>
                            <th>
                                Address
                            </th>
                            <th>
                                User Picture
                            </th>
                            <th>
                                Taken
                            </th>
                            <th>
                                Asset Pic
                            </th>
                            <th>
                                Deed Pic
                            </th>
                            <th>
                                Type
                            </th>
                            <th>
                                Note
                            </th>
                            <th>
                                Area
                            </th>
                            <th>
                                Dept
                            </th>
                            <th>
                                Asset Name
                            </th>
                            <th>#</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</div>



@section scripts{
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('#OWNR_USER').autocomplete({
                source: '@Url.Action("getSuggession")'
            });
        });

        $(function () {
            $('.viewOwner').click(function () {
                var id = $('#OWNR_USER').val();
                var route = '@Url.Action("SingleOwnerView", "BikeOwner")?AssetName=' + id;
                $('#ViewEditPartialView').load(route);
            });
        });
    </script>
}


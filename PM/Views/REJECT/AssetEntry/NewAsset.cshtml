@model PM.Models.P_ASSET

@{
    ViewBag.Title = "NewAsset";
    Layout = "~/Views/Shared/_LayoutLG.cshtml";
}

<div class="row margin">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                New Asset
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="panel-body">

                @using (Html.BeginForm("NewAsset", "AssetEntry", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal col-md-6">

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Code</span>
                                @Html.EditorFor(model => model.ASET_TEXT, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "If not exist, left blank", maxlength = "30" } })
                                @Html.ValidationMessageFor(model => model.ASET_TEXT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Asset Name</span>
                                @Html.EditorFor(model => model.ASET_NAME, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "Asset Name", autofocus = true, onchange = "CopyToCode();", maxlength = "50"} })
                                @Html.ValidationMessageFor(model => model.ASET_NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Model</span>
                                @Html.EditorFor(model => model.ASET_MODL, new { htmlAttributes = new { @class = "form-control", placeholder = "Model" } })
                                @Html.ValidationMessageFor(model => model.ASET_MODL, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Type</span>
                                @Html.EditorFor(model => model.ASET_TYPE, new { htmlAttributes = new { @class = "form-control", placeholder = "Asset Type" } })
                                @Html.ValidationMessageFor(model => model.ASET_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">PO</span>
                                @Html.EditorFor(model => model.ENGN_PONO, new { htmlAttributes = new { @class = "form-control", placeholder = "PO Number" } })
                                @Html.ValidationMessageFor(model => model.ENGN_PONO, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">GRN</span>
                                @Html.EditorFor(model => model.CHSS_GRN, new { htmlAttributes = new { @class = "form-control", placeholder = "GRN Number" } })
                                @Html.ValidationMessageFor(model => model.CHSS_GRN, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Capacity</span>
                                @Html.EditorFor(model => model.ASET_CPCT, new { htmlAttributes = new { @class = "form-control", placeholder = "Capacity" } })
                                @Html.ValidationMessageFor(model => model.ASET_CPCT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Price</span>
                                @Html.EditorFor(model => model.ASET_PRIC, new { htmlAttributes = new { @class = "form-control", placeholder = "Price" } })
                                @Html.ValidationMessageFor(model => model.ASET_PRIC, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Reg Date</span>
                                @Html.EditorFor(model => model.REG_DATE, new { htmlAttributes = new { @class = "form-control", type = "date", placeholder = "Registration Date", required = "required" } })
                                @Html.ValidationMessageFor(model => model.REG_DATE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Picture</span>
                                <input type="file" name="file" id="file" class="form-control">
                                <p class="help-block">*.jpg,*.jpeg,*.png files only</p>
                            </div>
                        </div>
                    </div>
                    <div class="form-horizontal col-md-6">
                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Body</span>
                                @Html.EditorFor(model => model.BODY_TYPE, new { htmlAttributes = new { @class = "form-control", placeholder = "Stand/Box" } })
                                @Html.ValidationMessageFor(model => model.BODY_TYPE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Color</span>
                                @Html.EditorFor(model => model.ASET_COLR, new { htmlAttributes = new { @class = "form-control", placeholder = "Green/Red/White/Blue" } })
                                @Html.ValidationMessageFor(model => model.ASET_COLR, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Year</span>
                                @Html.EditorFor(model => model.MFG_YEAR, new { htmlAttributes = new { @class = "form-control", type = "number", required = "required" } })
                                @Html.ValidationMessageFor(model => model.MFG_YEAR, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Note</span>
                                @Html.EditorFor(model => model.ASET_NOTE, new { htmlAttributes = new { @class = "form-control", maxlength = "100", placeholder = "Note" } })
                                @Html.ValidationMessageFor(model => model.ASET_NOTE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Group</span>
                                @Html.DropDownListFor(model => model.ASET_ASGR, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FindAccessories();" })
                                @Html.ValidationMessageFor(model => model.ASET_ASGR, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Business Unit</span>
                                @Html.DropDownList("AllBEUN", null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", onchange = "FindDepts();" })
                                @Html.ValidationMessage("AllBEUN", "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Department</span>
                                @Html.DropDownList("ASET_DEPT", Enumerable.Empty<SelectListItem>(), "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required", name = "ASET_DEPT", id = "ASET_DEPT" })
                                @Html.ValidationMessageFor(model => model.ASET_DEPT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Area</span>
                                @Html.DropDownListFor(model => model.ASET_AREA, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_AREA, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 input-group">
                                <span class="input-group-addon">Brand</span>
                                @Html.DropDownListFor(model => model.ASET_BRND, null, "--Select--", htmlAttributes: new { @class = "form-control select2", style = "width:100%;", required = "required" })
                                @Html.ValidationMessageFor(model => model.ASET_BRND, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-10">
                                <button type="submit" class="btn btn-danger pull-right"><i class="fa fa-save"></i> Save</button>
                                <a href="@Url.Action("Index","AssetEntry")" class="btn btn-primary"><i class="fa fa-arrow-circle-left"></i> Back</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="panel-footer">
               New Asset Entry
            </div>
        </div>
    </div>   
</div>


@section scripts{
    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('#ASET_NAME').autocomplete({
                source: '@Url.Action("Autocomplete")'
            });
        });

        function FindDepts() {
            var url = '@Url.Action("getDept", "AssetEntry")';
            var ASET_DEPT = $('#ASET_DEPT');
            var id = $('#AllBEUN').val();
            $.getJSON(url, { BeuId: id }, function (response) {
                ASET_DEPT.empty();
                ASET_DEPT.append($("<option></option>").attr("value", '').text('--Select Unit--'));
                $.each(response, function (index, item) {
                    ASET_DEPT.append($("<option></option>").attr("value", item.DEPT_TEXT).text(item.DEPT_NAME));
                });
            });
        }

        function CopyToCode() {
            var a = $('#ASET_TEXT').val();
            if (a.length === 0) {
                $('#ASET_TEXT').val($('#ASET_NAME').val());
            }
        }


        function FindAccessories() {
            var url = '@Url.Action("getAccItem", "AssetEntry")';
            var AccItem = $('#AccItem');
            var id = $('#ASET_ASGR').val();
            $.getJSON(url, { AccItem: id }, function (response) {
                AccItem.empty();
                AccItem.append($("<option></option>").attr("value", '').text('--Select Item--'));
                $.each(response, function (index, item) {
                    AccItem.append($("<option></option>").attr("value", item.ASAC_TEXT).text(item.ASAC_NAME));
                });
            });
        }

    </script>

}